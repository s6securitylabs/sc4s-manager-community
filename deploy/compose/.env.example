# Released defaults are versioned. Review and update pins deliberately.
SC4S_IMAGE=ghcr.io/splunk/splunk-connect-for-syslog/container3:3.46.0
SC4S_MANAGER_VERSION=3.46.0-beta

# Manager is loopback-only by default. Set a non-loopback address only after a
# trusted edge proxy and proxy authentication mode are configured.
SC4S_MANAGER_BIND_ADDRESS=127.0.0.1
SC4S_SOURCE_LISTEN_TCP_PORT=514
SC4S_SOURCE_LISTEN_UDP_PORT=514
SC4S_SOURCE_LISTEN_RFC6587_PORT=601
SC4S_SOURCE_LISTEN_TLS_PORT=6514
SC4S_LISTEN_STATUS_PORT=8080
SC4S_MANAGER_PORT=8090
