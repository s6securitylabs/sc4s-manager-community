# Choose exactly one browser authentication mode: standalone or proxy.
SC4S_MANAGER_AUTH_MODE=

# Standalone mode: generate with `openssl rand -hex 32`.
SC4S_MANAGER_MANUAL_LOGIN_TOKEN=

# Proxy mode: generate with `openssl rand -hex 32`; the trusted proxy strips any
# client value and injects X-SC4S-Manager-Proxy with this secret.
SC4S_MANAGER_PROXY_SECRET=
SC4S_MANAGER_ADMIN_GROUPS=

# Optional loopback automation token. Generate independently when needed.
SC4S_MANAGER_API_TOKEN=
