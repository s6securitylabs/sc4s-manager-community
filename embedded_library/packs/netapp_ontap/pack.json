{
  "schema_version": "0.1",
  "id": "netapp_ontap",
  "version": "0.1.6",
  "url": "https://raw.githubusercontent.com/splunk/splunk-connect-for-syslog/main/docs/sources/vendor/NetApp/ontap.md",
  "description": "Curated SecHub Resources SC4S pack for NetApp ONTAP EMS syslog. Extends upstream SC4S ONTAP inventory with dedicated-listener guidance, fixtures, Splunk knowledge, and explicit validation gaps.",
  "display_name": "NetApp ONTAP",
  "vendor": "netapp",
  "product": "ontap",
  "default_index": "infraops",
  "default_source": "netapp_ontap",
  "listener": {
    "source_id": "NETAPP_ONTAP",
    "transport": "tls",
    "port": 20093,
    "env": {
      "SC4S_LISTEN_NETAPP_ONTAP_TLS_PORT": "20093",
      "SOURCE_ALL_SET_APPEND": "NETAPP_ONTAP"
    }
  },
  "sourcetypes": {
    "ems_legacy": "ontap:ems"
  },
  "event_families": [
    {
      "id": "ems_legacy",
      "label": "NetApp ONTAP EMS legacy syslog events",
      "match_engine": "pcre",
      "match": "[A-Za-z0-9_.-]+: [0-9a-f]+\\.[0-9a-f]+ [0-9a-f]+ [A-Z][A-Za-z]+ ",
      "expected_sourcetype": "ontap:ems",
      "primary_id_field": "ontap_event_id",
      "required_fields": [
        "ontap_node",
        "ontap_event_id",
        "severity"
      ],
      "timestamp_fields": [
        "embedded_ontap_timestamp",
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "NetApp",
    "product": "ONTAP",
    "vendor_product": "netapp:ontap",
    "signature_id": "ontap_event_id",
    "signature": "event or message",
    "severity": "severity",
    "host": "ontap_node"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-netapp_ontap.conf",
      "sc4s/env.example"
    ],
    "splunk": [
      "splunk/default/props.conf",
      "splunk/default/transforms.conf",
      "splunk/default/eventtypes.conf",
      "splunk/default/tags.conf",
      "splunk/default/data/ui/views/netapp_ontap_overview.xml"
    ],
    "test_events": [
      "test-events/netapp_ontap_test_events.txt"
    ],
    "scripts": [
      "scripts/send_tls_20093.sh",
      "scripts/e2e_docker_compose.sh"
    ],
    "docs": [
      "README.md",
      "validation/preflight-2026-06-07.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tls_rfc5425",
      "label": "TLS syslog RFC5425 dedicated listener",
      "transport": "tls",
      "recommended": true,
      "default_port": 20093,
      "notes": "Recommended SecHub Resources pattern because ONTAP messages are not distinctive; use a dedicated listener or host/source mapping.",
      "syslog_protocol": "rfc5425",
      "framing": "octet_counted",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "custom_application"
    },
    {
      "id": "tcp_syslog",
      "label": "TCP syslog dedicated listener",
      "transport": "tcp",
      "recommended": false,
      "default_port": 5005,
      "notes": "Upstream docs show unique-port identification as an option.",
      "syslog_protocol": "tcp_syslog",
      "framing": "line_delimited",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "custom_application"
    },
    {
      "id": "udp_syslog",
      "label": "UDP syslog dedicated listener",
      "transport": "udp",
      "recommended": false,
      "default_port": 5005,
      "notes": "Legacy/lab only due to loss risk.",
      "syslog_protocol": "udp_syslog",
      "framing": "datagram",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "custom_application"
    }
  ],
  "recommended_transport": "tls_rfc5425",
  "source_log_version": {
    "name": "NetApp ONTAP EMS syslog",
    "min": null,
    "max": null,
    "notes": "Grounded in upstream SC4S ONTAP parser/docs; new-format audit/EMS requires real sample evidence."
  },
  "validation": {
    "date_validated": "not lab validated; curated 2026-06-05",
    "validated_by": "Hermes autonomous curation (upstream-grounded only)",
    "source_log_version": "Upstream SC4S ONTAP parser/docs plus synthetic-equivalent fixtures only",
    "sc4s_version": "not lab validated",
    "splunk_version": "not lab validated",
    "evidence": "Live ONTAP replay and Splunk read-back evidence is not yet captured; keep quality_status=curated and trust_level=unverified."
  },
  "test_event_sets": [
    {
      "id": "netapp_ontap_ems_legacy_bsd",
      "label": "NetApp ONTAP EMS legacy BSD-style fixtures",
      "path": "test-events/netapp_ontap_test_events.txt",
      "format": "bsd",
      "wire_format": "bsd_syslog_with_ontap_payload",
      "envelope": "bsd_rfc3164",
      "serialization": "custom_application",
      "event_count": 2,
      "events_per_file": "multiple",
      "event_boundary": "line",
      "record_separator": "\\n",
      "one_event_per_line": true,
      "multiline": false,
      "unique_events": true,
      "marker_tokens": [
        "SC4S_NETAPP_ONTAP_TEST_EMS_NOTICE_001",
        "SC4S_NETAPP_ONTAP_TEST_EMS_ERROR_002"
      ],
      "timestamp_policy": {
        "source_time_mode": "field_with_timezone",
        "primary_field": "embedded_ontap_timestamp",
        "primary_timezone": "offset included in fixture payload timestamps",
        "fallback_fields": [
          "syslog_header"
        ],
        "fallback_time_mode": "receiver_time",
        "fallback_timezone": "receiver_default",
        "requires_source_timezone_when_fields_missing": [
          "embedded_ontap_timestamp"
        ],
        "notes": "Upstream parser extracts an embedded ONTAP timestamp where present."
      },
      "field_delimiting": {
        "style": "custom_text_prefix_then_message",
        "field_separator": "spaces in fixed prefix; message text after timestamp",
        "quote_character": "none in fixtures",
        "escape_policy": "Real ONTAP EMS messages may include additional punctuation; fixtures are smoke tests only.",
        "notes": "Treat each physical line as one event."
      },
      "expected_families": [
        "ems_legacy"
      ]
    }
  ],
