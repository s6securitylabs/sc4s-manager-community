      "label": "TCP syslog",
      "transport": "tcp",
      "recommended": true,
      "default_port": 20044,
      "notes": "Dedicated SecHub Resources TCP listener for lab/onboarding; fixtures are RFC5424-style line-delimited events.",
      "syslog_protocol": "tcp_syslog",
      "framing": "line_delimited",
      "envelope": "ietf_rfc5424",
      "payload_format": "custom_application"
    },
    {
