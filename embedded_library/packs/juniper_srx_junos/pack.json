{
  "schema_version": "0.1",
  "id": "juniper_srx_junos",
  "version": "0.1.5",
  "url": "https://raw.githubusercontent.com/splunk/splunk-connect-for-syslog/main/docs/sources/vendor/Juniper/junos.md",
  "description": "Conservative SecHub Resources SC4S pack for Juniper SRX/Junos RFC5424 structured syslog security events. Extends upstream SC4S Junos structured inventory with public-example grounded fixtures, minimal routing, and Splunk search-time field extraction without stating lab validation.",
  "display_name": "Juniper SRX Junos Structured Syslog",
  "vendor": "juniper",
  "product": "srx",
  "default_index": "netfw",
  "default_source": "juniper_srx_junos",
  "listener": {
    "source_id": "JUNIPER_SRX_JUNOS",
    "transport": "tcp",
    "port": 20044,
    "env": {
      "SC4S_LISTEN_JUNIPER_SRX_JUNOS_TCP_PORT": "20044",
      "SOURCE_ALL_SET_APPEND": "JUNIPER_SRX_JUNOS"
    }
  },
  "sourcetypes": {
    "flow": "juniper:junos:firewall",
    "idp": "juniper:junos:idp",
    "utm": "juniper:junos:utm"
  },
  "event_families": [
    {
      "id": "flow",
      "label": "Juniper SRX RT_FLOW session events",
      "match_engine": "pcre",
      "match": "RT_FLOW_SESSION_(?:CREATE|DENY)",
      "expected_sourcetype": "juniper:junos:firewall",
      "primary_id_field": "juniper_event",
      "required_fields": [
        "juniper_program",
        "juniper_event",
        "src_ip",
        "dest_ip"
      ],
      "timestamp_fields": [
        "rfc5424_timestamp"
      ]
    },
    {
      "id": "idp",
      "label": "Juniper SRX RT_IDP attack events",
      "match_engine": "pcre",
      "match": "IDP_ATTACK_LOG_EVENT",
      "expected_sourcetype": "juniper:junos:idp",
      "primary_id_field": "attack-name",
      "required_fields": [
        "juniper_program",
        "juniper_event",
        "src_ip",
        "dest_ip",
        "attack-name"
      ],
      "timestamp_fields": [
        "rfc5424_timestamp",
        "epoch-time"
      ]
    },
    {
      "id": "utm",
      "label": "Juniper SRX RT_UTM web-filter events",
      "match_engine": "pcre",
      "match": "WEBFILTER_URL_BLOCKED",
      "expected_sourcetype": "juniper:junos:utm",
      "primary_id_field": "juniper_event",
      "required_fields": [
        "juniper_program",
        "juniper_event",
        "src_ip",
        "dest_ip",
        "url"
      ],
      "timestamp_fields": [
        "rfc5424_timestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Juniper",
    "product": "SRX",
    "vendor_product": "juniper:srx",
    "src": "src_ip",
    "dest": "dest_ip",
