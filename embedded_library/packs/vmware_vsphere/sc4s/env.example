# VMware vSphere dedicated listener example for SecHub Resources import.
# Prefer TLS/RFC5425 or a trusted relay. Avoid UDP load-balanced paths for
# VMware events because upstream SC4S documents split/malformed event risks.
SC4S_LISTEN_VMWARE_VSPHERE_TLS_PORT=20051
SOURCE_ALL_SET_APPEND=VMWARE_VSPHERE

# Review locally before enabling upstream grouping/cache behavior:
# SC4S_SOURCE_VMWARE_VSPHERE_GROUPMSG=yes
# SC4S_USE_NAME_CACHE=yes
# SC4S_USE_VPS_CACHE=yes
