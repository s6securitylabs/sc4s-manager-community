    "dest": "Destination alias",
    "app": "Application name",
    "site": "Site/domain context",
    "url": "URL/path context",
    "action": "Policy/action token",
    "policy": "Policy name",
    "severity": "Alert/incident severity",
    "alert_type": "Alert type",
    "activity": "Application/audit activity",
    "object": "Object/file/policy context",
