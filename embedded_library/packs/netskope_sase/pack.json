{
  "schema_version": "0.1",
  "id": "netskope_sase",
  "version": "0.1.1",
  "url": "https://github.com/netskopeoss/Data-Schema",
  "description": "Curated SecHub Resources SC4S pack for Netskope Security Cloud / SASE Data Export and transaction log-streaming JSON relay records.",
  "display_name": "Netskope SASE / Security Cloud JSON Relay",
  "vendor": "netskope",
  "product": "security_cloud",
  "default_index": "netproxy",
  "default_source": "netskope_sase",
  "listener": {
    "source_id": "NETSKOPE_SASE",
    "transport": "tcp",
    "port": 20101,
    "env": {
      "SC4S_LISTEN_NETSKOPE_SASE_TCP_PORT": "20101",
      "SOURCE_ALL_SET_APPEND": "NETSKOPE_SASE"
    }
  },
  "sourcetypes": {
    "page": "netskope:events:page",
    "application": "netskope:events:application",
    "alert": "netskope:alerts",
    "audit": "netskope:audit",
    "network": "netskope:events:network",
    "transaction": "netskope:transaction"
  },
  "event_families": [
    {
      "id": "page",
      "label": "Netskope page/web events",
      "match_engine": "pcre",
      "match": "\\\"type\\\"\\s*:\\s*\\\"page\\\"",
      "expected_sourcetype": "netskope:events:page",
      "primary_id_field": "_id",
      "required_fields": [
        "timestamp",
        "type",
        "user",
        "srcip",
        "app",
        "site",
        "action",
        "marker"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "application",
      "label": "Netskope application events",
      "match_engine": "pcre",
      "match": "\\\"type\\\"\\s*:\\s*\\\"application\\\"",
      "expected_sourcetype": "netskope:events:application",
      "primary_id_field": "_id",
      "required_fields": [
        "timestamp",
        "type",
        "user",
        "app",
        "activity",
        "object",
        "marker"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "alert",
      "label": "Netskope alerts",
      "match_engine": "pcre",
      "match": "\\\"type\\\"\\s*:\\s*\\\"alert\\\"",
      "expected_sourcetype": "netskope:alerts",
      "primary_id_field": "_id",
      "required_fields": [
        "timestamp",
        "type",
        "alert",
        "alert_type",
        "severity",
        "policy",
        "marker"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "audit",
      "label": "Netskope audit events",
      "match_engine": "pcre",
      "match": "\\\"type\\\"\\s*:\\s*\\\"audit\\\"",
      "expected_sourcetype": "netskope:audit",
      "primary_id_field": "_id",
      "required_fields": [
        "timestamp",
        "type",
        "user",
        "activity",
        "object",
        "marker"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "network",
      "label": "Netskope network events",
      "match_engine": "pcre",
      "match": "\\\"type\\\"\\s*:\\s*\\\"network\\\"",
      "expected_sourcetype": "netskope:events:network",
      "primary_id_field": "_id",
      "required_fields": [
        "timestamp",
        "type",
        "user",
        "srcip",
        "dstip",
        "action",
        "marker"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "transaction",
      "label": "Netskope transaction log-streaming events",
      "match_engine": "pcre",
      "match": "\\\"x-transaction-id\\\"\\s*:",
      "expected_sourcetype": "netskope:transaction",
      "primary_id_field": "x-transaction-id",
      "required_fields": [
        "x-cs-timestamp",
        "x-transaction-id",
        "x-cs-user",
        "cs-host",
        "cs-method",
        "x-policy-action",
        "marker"
      ],
      "timestamp_fields": [
        "x-cs-timestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "netskope",
    "product": "security_cloud",
    "vendor_product": "netskope:security_cloud",
    "netskope_event_family": "Derived fixture-backed family",
    "_id": "Netskope event identifier where present",
