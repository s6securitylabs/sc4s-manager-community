{
  "schema_version": "0.1",
  "id": "gitlab_audit_security",
  "version": "0.1.1",
  "url": "https://gitlab.com/gitlab-org/gitlab/-/raw/master/doc/api/audit_events.md",
  "description": "Curated SecHub Resources SC4S pack for GitLab Audit Events API and audit-event-streaming JSON records relayed as one JSON object per line, with fixture-backed project, group, user/account, and audit-streaming configuration change families.",
  "display_name": "GitLab Audit and Security Events",
  "vendor": "gitlab",
  "product": "audit_events",
  "default_index": "gitops",
  "default_source": "gitlab_audit_security",
  "listener": {
    "source_id": "GITLAB_AUDIT_SECURITY",
    "transport": "tcp",
    "port": 20099,
    "env": {
      "SC4S_LISTEN_GITLAB_AUDIT_SECURITY_TCP_PORT": "20099",
      "SOURCE_ALL_SET_APPEND": "GITLAB_AUDIT_SECURITY"
    }
  },
  "sourcetypes": {
    "project_admin_change": "gitlab:audit:json",
    "group_admin_change": "gitlab:audit:json",
    "user_account_change": "gitlab:audit:json",
    "audit_streaming_config_change": "gitlab:audit:json"
  },
  "event_families": [
    {
      "id": "project_admin_change",
      "label": "GitLab project administrative changes",
      "match_engine": "pcre",
      "match": "\\\"entity_type\\\"\\s*:\\s*\\\"Project\\\"",
      "expected_sourcetype": "gitlab:audit:json",
      "primary_id_field": "id",
      "required_fields": [
        "id",
        "created_at",
        "entity_type",
        "details"
      ],
      "timestamp_fields": [
        "created_at"
      ]
    },
    {
      "id": "group_admin_change",
      "label": "GitLab group administrative changes",
      "match_engine": "pcre",
      "match": "\\\"entity_type\\\"\\s*:\\s*\\\"Group\\\"",
      "expected_sourcetype": "gitlab:audit:json",
      "primary_id_field": "id",
      "required_fields": [
        "id",
        "created_at",
        "entity_type",
        "details"
      ],
      "timestamp_fields": [
        "created_at"
      ]
    },
    {
      "id": "user_account_change",
      "label": "GitLab user/account changes",
      "match_engine": "pcre",
      "match": "\\\"entity_type\\\"\\s*:\\s*\\\"User\\\"",
      "expected_sourcetype": "gitlab:audit:json",
      "primary_id_field": "id",
      "required_fields": [
        "id",
        "created_at",
        "entity_type",
        "details"
      ],
      "timestamp_fields": [
        "created_at"
      ]
    },
    {
      "id": "audit_streaming_config_change",
      "label": "GitLab audit streaming configuration changes",
      "match_engine": "pcre",
      "match": "\\\"event_type\\\"\\s*:\\s*\\\"audit_events_streaming_instance_headers_create\\\"",
      "expected_sourcetype": "gitlab:audit:json",
      "primary_id_field": "id",
      "required_fields": [
        "id",
        "created_at",
        "entity_type",
        "details"
      ],
      "timestamp_fields": [
        "created_at"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "gitlab",
    "product": "audit_events",
    "vendor_product": "gitlab:audit_events",
    "gitlab_audit_family": "Derived family for project/group/user/streaming changes",
