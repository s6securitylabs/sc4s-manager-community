{
  "schema_version": "0.1",
  "id": "sophos_firewall",
  "version": "0.1.1",
  "url": "https://docs.sophos.com/nsg/sophos-firewall/21.0/syslog/index.html",
  "description": "Curated SecHub Resources SC4S pack for Sophos Firewall SFOS key=value syslog records, with conservative firewall traffic, IPS, VPN, and system-health fixture coverage from public Sophos syslog documentation.",
  "display_name": "Sophos Firewall",
  "vendor": "sophos",
  "product": "firewall",
  "default_index": "netfw",
  "default_source": "sophos_firewall",
  "listener": {
    "source_id": "SOPHOS_FIREWALL",
    "transport": "tls",
    "port": 20097,
    "env": {
      "SC4S_LISTEN_SOPHOS_FIREWALL_TLS_PORT": "20097",
      "SOURCE_ALL_SET_APPEND": "SOPHOS_FIREWALL"
    }
  },
  "sourcetypes": {
    "traffic_allow": "sophos:firewall:traffic",
    "traffic_deny": "sophos:firewall:traffic",
    "ips_detected": "sophos:firewall:ips",
    "vpn_login": "sophos:firewall:vpn",
    "system_health": "sophos:firewall:system"
  },
  "event_families": [
    {
      "id": "traffic_allow",
      "label": "Sophos Firewall allowed traffic",
      "match_engine": "pcre",
      "match": "status=Allow.*SC4S_SOPHOS_FIREWALL_TEST_TRAFFIC_ALLOW_001",
      "expected_sourcetype": "sophos:firewall:traffic",
      "primary_id_field": "log_id",
      "required_fields": [
        "log_id",
        "status",
        "src_ip",
        "dst_ip",
        "fw_rule_id"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "traffic_deny",
      "label": "Sophos Firewall denied traffic",
      "match_engine": "pcre",
      "match": "status=Deny.*SC4S_SOPHOS_FIREWALL_TEST_TRAFFIC_DENY_002",
      "expected_sourcetype": "sophos:firewall:traffic",
      "primary_id_field": "log_id",
      "required_fields": [
        "log_id",
        "status",
        "src_ip",
        "dst_ip",
        "fw_rule_id"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "ips_detected",
      "label": "Sophos Firewall IPS/security detection",
      "match_engine": "pcre",
      "match": "log_component=IPS.*SC4S_SOPHOS_FIREWALL_TEST_IPS_DETECTED_003",
      "expected_sourcetype": "sophos:firewall:ips",
      "primary_id_field": "log_id",
      "required_fields": [
        "log_id",
        "threat",
        "src_ip",
        "dst_ip",
        "status"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "vpn_login",
      "label": "Sophos Firewall VPN login",
      "match_engine": "pcre",
      "match": "log_component=\"SSL VPN\".*SC4S_SOPHOS_FIREWALL_TEST_VPN_LOGIN_004",
      "expected_sourcetype": "sophos:firewall:vpn",
      "primary_id_field": "log_id",
      "required_fields": [
        "log_id",
        "user_name",
        "status",
        "src_ip"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "system_health",
      "label": "Sophos Firewall system health",
      "match_engine": "pcre",
      "match": "log_type=System.*SC4S_SOPHOS_FIREWALL_TEST_SYSTEM_HEALTH_005",
      "expected_sourcetype": "sophos:firewall:system",
      "primary_id_field": "log_id",
      "required_fields": [
        "log_id",
        "severity",
        "status",
        "device_name"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "sophos",
    "product": "firewall",
    "vendor_product": "sophos:firewall",
    "sophos_firewall_family": "Derived family label from log_component/log_type",
    "log_id": "Sophos 12-character log identifier",
    "log_type": "Sophos log type",
    "log_component": "Sophos component",
    "log_subtype": "Sophos subtype",
    "severity": "Sophos severity/priority token",
    "status": "Sophos status token",
    "action": "Analyst action derived from status/log_subtype",
    "vendor_raw_action": "Raw Sophos status/log_subtype action token",
    "signature": "Message/threat summary",
    "signature_id": "Alias of log_id",
    "src": "Alias of src_ip",
    "dest": "Alias of dst_ip",
    "src_port": "Source port where supplied",
    "dst_port": "Destination port where supplied",
    "transport": "Protocol uppercased from protocol",
    "user": "Alias of user_name",
    "src_user": "Alias of user_name",
    "fw_rule_id": "Firewall rule identifier",
    "threat": "IPS/security threat or signature context",
    "bytes_sent": "Bytes sent where supplied",
    "bytes_received": "Bytes received where supplied",
    "dvc": "Alias of device_name",
    "serial": "Alias of device_serial_id",
    "marker": "Synthetic fixture marker only"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-sophos_firewall.conf",
      "sc4s/env.example"
    ],
    "splunk": [
      "splunk/default/props.conf",
      "splunk/default/transforms.conf",
      "splunk/default/eventtypes.conf",
      "splunk/default/tags.conf",
      "splunk/default/data/ui/views/sophos_firewall_overview.xml"
    ],
    "test_events": [
      "test-events/sophos_firewall_test_events.txt"
    ],
    "scripts": [
      "scripts/send_tls_20097.sh",
      "scripts/e2e_docker_compose.sh"
    ],
    "docs": [
      "README.md",
      "validation/preflight-2026-06-20.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tls_rfc5425",
      "label": "TLS syslog RFC5425",
      "transport": "tls",
      "recommended": true,
      "default_port": 20097,
      "notes": "Recommended production transport for Sophos Firewall syslog into SC4S.",
      "syslog_protocol": "rfc5425",
      "framing": "octet_counted",
      "envelope": "ietf_rfc5424",
      "payload_format": "custom_application"
    },
    {
      "id": "tcp_syslog",
      "label": "TCP syslog",
      "transport": "tcp",
      "recommended": false,
      "default_port": 20097,
      "notes": "Use when TLS termination is handled elsewhere or source cannot use TLS.",
      "syslog_protocol": "tcp_syslog",
      "framing": "line_delimited",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "custom_application"
    },
    {
      "id": "udp_syslog",
      "label": "UDP syslog",
      "transport": "udp",
      "recommended": false,
      "default_port": 514,
      "notes": "Supported for lab/legacy only; avoid where event loss matters.",
      "syslog_protocol": "udp_syslog",
      "framing": "datagram",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "custom_application"
    }
  ],
  "recommended_transport": "tls_rfc5425",
  "source_log_version": {
    "name": "Sophos Firewall SFOS syslog key=value format",
    "min": "SFOS 21.0 public syslog reference inspected 2026-06-20",
    "max": null,
    "notes": "Grounded in public Sophos Firewall syslog documentation. Exact field presence can vary by SFOS version and configured log category."
  },
  "validation": {
    "date_validated": "not lab validated; curated 2026-06-20",
    "validated_by": "Hermes autonomous curation (public-documentation-grounded only)",
    "source_log_version": "Sophos Firewall public syslog docs and synthetic-equivalent fixtures only",
    "sc4s_version": "not lab validated",
    "splunk_version": "not lab validated",
    "evidence": "Repository schema/fixture checks exercise synthetic-equivalent Sophos Firewall key=value records only. Local replay preflight is blocked by missing Sophos Firewall listener and Splunk management/search path; no live Sophos Firewall replay, HEC delivery, or Splunk read-back captured."
  },
  "test_event_sets": [
    {
      "id": "sophos_firewall_headerless_kv",
      "label": "Sophos Firewall headerless key=value fixtures",
      "path": "test-events/sophos_firewall_test_events.txt",
      "format": "custom_application",
      "wire_format": "headerless_sophos_firewall_key_value_payload",
      "envelope": "none",
      "serialization": "space_delimited_key_value",
      "event_count": 5,
      "events_per_file": "multiple",
      "event_boundary": "line",
      "record_separator": "\\n",
      "one_event_per_line": true,
      "multiline": false,
      "unique_events": true,
      "marker_tokens": [
        "SC4S_SOPHOS_FIREWALL_TEST_TRAFFIC_ALLOW_001",
        "SC4S_SOPHOS_FIREWALL_TEST_TRAFFIC_DENY_002",
        "SC4S_SOPHOS_FIREWALL_TEST_IPS_DETECTED_003",
        "SC4S_SOPHOS_FIREWALL_TEST_VPN_LOGIN_004",
        "SC4S_SOPHOS_FIREWALL_TEST_SYSTEM_HEALTH_005"
      ],
      "timestamp_policy": {
        "source_time_mode": "syslog_header_timezone",
        "primary_field": "syslog_header",
        "primary_timezone": "UTC in TLS send helper; source-defined in production syslog envelope",
        "fallback_fields": [],
        "fallback_time_mode": "receiver_time",
        "fallback_timezone": "receiver local if no syslog header exists",
        "requires_source_timezone_when_fields_missing": [
          "syslog_header"
        ],
        "notes": "Fixture payloads are headerless; send helper wraps payloads with a timezone-qualified RFC5424/RFC5425 timestamp."
      },
      "field_delimiting": {
        "style": "key_value",
        "field_separator": "space",
        "key_value_separator": "=",
        "quote_character": "double_quote for values containing spaces in supplied fixtures",
        "escape_policy": "Additional real-product fixtures are required before stating complete Sophos quoting/escaping coverage.",
        "notes": "Treat each physical line as one event."
      },
      "expected_families": [
        "traffic_allow",
        "traffic_deny",
        "ips_detected",
        "vpn_login",
        "system_health"
      ]
    }
  ],
