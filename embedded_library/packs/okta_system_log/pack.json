    "result": "Okta outcome.result",
    "result_reason": "Okta outcome.reason",
    "signature": "Okta displayMessage",
    "severity": "Okta severity token",
    "object": "Target displayName",
    "object_type": "Target type",
    "target_user": "Target alternateId for lifecycle, application-assignment, and risk rows when present",
    "credential_type": "MFA credential type",
    "authentication_provider": "Authentication provider",
    "policy_id": "Policy ID in debug data when present",
    "request_id": "Okta request ID",
    "marker": "Synthetic fixture marker only",
    "session_id": "Okta transaction.id for session/OAuth correlation when present",
    "user_agent": "Client user-agent string when present",
    "oauth_client_id": "OAuth client ID from debugContext.debugData.clientId when present",
    "grant_type": "OAuth grant type from debugContext.debugData.grantType when present",
    "scopes": "OAuth scopes from debugContext.debugData.scopes when present",
    "object_id": "Target object ID from target array when present",
    "app_assignment": "Application user-membership event context from application.user_membership.* events",
    "risk_event": "User risk event context from user.risk.* events"
