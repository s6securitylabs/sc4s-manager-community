{
  "schema_version": "0.1",
  "id": "okta_system_log",
  "version": "0.1.5",
  "url": "https://developer.okta.com/docs/reference/system-log-query/",
  "description": "Curated SecHub Resources SC4S pack for Okta System Log JSON relays, covering fixture-backed authentication/session, MFA, user lifecycle, policy/admin, API token/OAuth, application assignment, and user risk events.",
  "display_name": "Okta System Log",
  "vendor": "okta",
  "product": "system_log",
  "default_index": "netauth",
  "default_source": "okta_system_log",
  "listener": {
    "source_id": "OKTA_SYSTEM_LOG",
    "transport": "tcp",
    "port": 20066,
    "env": {
      "SC4S_LISTEN_OKTA_SYSTEM_LOG_TCP_PORT": "20066",
      "SOURCE_ALL_SET_APPEND": "OKTA_SYSTEM_LOG"
    }
  },
  "sourcetypes": {
    "authn": "okta:system:authn",
    "mfa": "okta:system:mfa",
    "lifecycle": "okta:system:lifecycle",
    "policy": "okta:system:policy",
    "api_token": "okta:system:api_token",
    "app": "okta:system:app",
    "risk": "okta:system:risk"
  },
  "event_families": [
    {
      "id": "authn",
      "label": "Okta authentication and session events",
      "match_engine": "pcre",
      "match": "\"eventType\"\\s*:\\s*\"user\\.(authentication|session)\\.",
      "expected_sourcetype": "okta:system:authn",
      "primary_id_field": "uuid",
      "required_fields": [
        "published",
        "eventType",
        "actor",
        "outcome"
      ],
      "timestamp_fields": [
        "published"
      ]
    },
    {
      "id": "mfa",
      "label": "Okta MFA events",
      "match_engine": "pcre",
      "match": "\"eventType\"\\s*:\\s*\"user\\.mfa\\.",
      "expected_sourcetype": "okta:system:mfa",
      "primary_id_field": "uuid",
      "required_fields": [
        "published",
        "eventType",
        "actor",
        "outcome"
      ],
      "timestamp_fields": [
        "published"
      ]
    },
    {
      "id": "lifecycle",
      "label": "Okta user lifecycle events",
      "match_engine": "pcre",
      "match": "\"eventType\"\\s*:\\s*\"user\\.lifecycle\\.",
      "expected_sourcetype": "okta:system:lifecycle",
      "primary_id_field": "uuid",
      "required_fields": [
        "published",
        "eventType",
        "actor",
        "target",
        "outcome"
      ],
      "timestamp_fields": [
        "published"
      ]
    },
    {
      "id": "policy",
      "label": "Okta policy and rule administration events",
      "match_engine": "pcre",
      "match": "\"eventType\"\\s*:\\s*\"policy\\.",
      "expected_sourcetype": "okta:system:policy",
      "primary_id_field": "uuid",
      "required_fields": [
        "published",
        "eventType",
        "actor",
        "target",
        "outcome"
      ],
      "timestamp_fields": [
        "published"
      ]
    },
    {
      "id": "api_token",
      "label": "Okta API token and OAuth client/token administration events",
      "match_engine": "pcre",
      "match": "\"eventType\"\\s*:\\s*\"(system\\.api_token|app\\.oauth2)\\.",
      "expected_sourcetype": "okta:system:api_token",
      "primary_id_field": "uuid",
      "required_fields": [
        "published",
        "eventType",
        "actor",
        "target",
        "outcome"
      ],
      "timestamp_fields": [
        "published"
      ]
    },
    {
      "id": "app",
      "label": "Okta application assignment and membership events",
      "match_engine": "pcre",
      "match": "\"eventType\"\\s*:\\s*\"application\\.user_membership\\.",
      "expected_sourcetype": "okta:system:app",
      "primary_id_field": "uuid",
      "required_fields": [
        "published",
        "eventType",
        "actor",
        "target",
        "outcome"
      ],
      "timestamp_fields": [
        "published"
      ]
    },
    {
      "id": "risk",
      "label": "Okta user risk signal events",
      "match_engine": "pcre",
      "match": "\"eventType\"\\s*:\\s*\"user\\.risk\\.",
      "expected_sourcetype": "okta:system:risk",
      "primary_id_field": "uuid",
      "required_fields": [
        "published",
        "eventType",
        "actor",
        "target",
        "outcome"
      ],
      "timestamp_fields": [
        "published"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Okta",
    "product": "system_log",
    "vendor_product": "okta:system_log",
    "event_type": "Okta System Log eventType",
    "event_id": "Okta System Log uuid",
    "published": "Okta event timestamp",
    "user": "Actor alternateId",
    "actor_id": "Actor id",
    "actor_display_name": "Actor displayName",
