{
  "schema_version": "0.1",
  "id": "slack_audit_logs",
  "version": "0.1.1",
  "url": "https://docs.slack.dev/admins/audit-logs-api",
  "description": "Curated SecHub Resources SC4S pack for Slack Enterprise Audit Logs API records relayed as one JSON object per line, with fixture-backed user session, anomaly, app security, file security, workspace administration, and user/admin role audit families.",
  "display_name": "Slack Audit Logs",
  "vendor": "slack",
  "product": "audit_logs",
  "default_index": "netauth",
  "default_source": "slack_audit_logs",
  "listener": {
    "source_id": "SLACK_AUDIT_LOGS",
    "transport": "tcp",
    "port": 20096,
    "env": {
      "SC4S_LISTEN_SLACK_AUDIT_LOGS_TCP_PORT": "20096",
      "SOURCE_ALL_SET_APPEND": "SLACK_AUDIT_LOGS"
    }
  },
  "sourcetypes": {
    "user_session": "slack:audit",
    "anomaly": "slack:audit",
    "app_security": "slack:audit",
    "file_security": "slack:audit",
    "workspace_admin": "slack:audit",
    "user_admin_role": "slack:audit"
  },
  "event_families": [
    {
      "id": "user_session",
      "label": "Slack user session audit events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"user_login\\\"",
      "expected_sourcetype": "slack:audit",
      "primary_id_field": "id",
      "required_fields": [
        "date_create",
        "action",
        "actor",
        "entity",
        "context"
      ],
      "timestamp_fields": [
        "date_create"
      ]
    },
    {
      "id": "anomaly",
      "label": "Slack anomaly audit events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"anomaly\\\"",
      "expected_sourcetype": "slack:audit",
      "primary_id_field": "id",
      "required_fields": [
        "date_create",
        "action",
        "actor",
        "entity",
        "context",
        "details"
      ],
      "timestamp_fields": [
        "date_create"
      ]
    },
    {
      "id": "app_security",
      "label": "Slack app security audit events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"app_approved\\\"",
      "expected_sourcetype": "slack:audit",
      "primary_id_field": "id",
      "required_fields": [
        "date_create",
        "action",
        "actor",
        "entity",
        "context"
      ],
      "timestamp_fields": [
        "date_create"
      ]
    },
    {
      "id": "file_security",
      "label": "Slack file security audit events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"file_downloaded\\\"",
      "expected_sourcetype": "slack:audit",
      "primary_id_field": "id",
      "required_fields": [
        "date_create",
        "action",
        "actor",
        "entity",
        "context"
      ],
      "timestamp_fields": [
        "date_create"
      ]
    },
    {
      "id": "workspace_admin",
      "label": "Slack workspace administration audit events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"workspace_settings_changed\\\"",
      "expected_sourcetype": "slack:audit",
      "primary_id_field": "id",
      "required_fields": [
        "date_create",
        "action",
        "actor",
        "entity",
        "context"
      ],
      "timestamp_fields": [
        "date_create"
      ]
    },
    {
      "id": "user_admin_role",
      "label": "Slack user/admin role audit events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"user_role_changed\\\"",
      "expected_sourcetype": "slack:audit",
      "primary_id_field": "id",
      "required_fields": [
        "date_create",
        "action",
        "actor",
        "entity",
        "context"
      ],
      "timestamp_fields": [
        "date_create"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "slack",
    "product": "audit_logs",
    "vendor_product": "slack:audit_logs",
    "slack_audit_family": "Derived from Slack audit action token",
    "id": "Slack Audit Logs API event identifier",
    "event_id": "Alias of Slack id",
    "date_create": "Slack Audit Logs API UTC epoch seconds timestamp",
    "action": "Slack audit action token",
    "signature": "Action token used as triage signature",
    "signature_id": "Slack event id or action fallback",
    "actor_id": "Actor user id where present",
    "actor_name": "Actor display/name where present",
    "actor_email": "Actor email where present; sensitive",
    "actor_type": "Actor object type",
    "user": "Actor user name/email/id fallback",
    "src_user": "Actor alias",
    "target_user": "Entity user name/email/id where present",
    "target_user_id": "Entity user id where present",
    "target_user_email": "Entity user email where present; sensitive",
    "object": "Entity id/type fallback",
    "object_type": "Slack entity type",
    "src_ip": "Context IP address",
    "src": "Source IP alias",
    "user_agent": "Context user-agent",
    "session_id": "Slack session id where present",
    "workspace_id": "Workspace/enterprise id where present",
    "workspace_name": "Workspace/enterprise name where present",
    "workspace_domain": "Workspace domain where present",
    "reason": "Anomaly reason where present",
    "previous_ip_address": "Previous IP address for anomaly rows where present",
    "previous_user_agent": "Previous user-agent for anomaly rows where present",
    "file_hash": "File MD5/hash context where present",
    "file_url_private": "Synthetic private file URL context where present; sensitive",
    "marker": "Synthetic fixture marker only"
  },
