  },
  "sourcetypes": {
    "login": "truenas:middleware:auth",
    "storage": "truenas:storage:pool",
    "snapshot": "truenas:storage:snapshot",
    "disk": "truenas:hardware:disk",
    "replication": "truenas:replication",
