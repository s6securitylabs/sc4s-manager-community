  },
  "event_families": [
    {
      "id": "login",
      "label": "TrueNAS middleware login events",
      "match_engine": "pcre",
      "match": "login (success|failure)|SC4S_TRUENAS_TEST_LOGIN_",
      "expected_sourcetype": "truenas:middleware:auth",
      "primary_id_field": "user",
      "required_fields": [
        "user",
        "src",
        "method",
        "result"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "storage",
      "label": "TrueNAS pool scrub/storage health events",
      "match_engine": "pcre",
      "match": "pool scrub|SC4S_TRUENAS_TEST_STORAGE_",
      "expected_sourcetype": "truenas:storage:pool",
      "primary_id_field": "pool",
      "required_fields": [
        "pool",
        "result",
        "errors"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "snapshot",
      "label": "TrueNAS dataset snapshot events",
      "match_engine": "pcre",
      "match": "dataset snapshot|SC4S_TRUENAS_TEST_SNAPSHOT_",
      "expected_sourcetype": "truenas:storage:snapshot",
      "primary_id_field": "dataset",
      "required_fields": [
        "dataset",
        "snapshot"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "disk",
      "label": "TrueNAS disk/SMART alerts",
      "match_engine": "pcre",
      "match": "disk alert|SC4S_TRUENAS_TEST_DISK_",
      "expected_sourcetype": "truenas:hardware:disk",
      "primary_id_field": "device",
      "required_fields": [
        "device",
        "serial",
        "severity",
        "status"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "replication",
      "label": "TrueNAS replication/task events",
      "match_engine": "pcre",
      "match": "replication task|SC4S_TRUENAS_TEST_REPLICATION_",
      "expected_sourcetype": "truenas:replication",
      "primary_id_field": "task",
      "required_fields": [
        "task",
        "result",
        "bytes"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "auth",
      "label": "TrueNAS host authentication events",
      "match_engine": "pcre",
      "match": "Failed password|Accepted password|SC4S_TRUENAS_TEST_AUTH_",
