{
  "schema_version": "0.1",
  "id": "kubernetes_audit",
  "version": "0.1.4",
  "url": "https://kubernetes.io/docs/tasks/debug/debug-cluster/audit/",
  "description": "Curated SecHub Resources SC4S pack for Kubernetes API server audit events relayed as one JSON record per line, with explicit RBAC, secret access, workload, exec, impersonation, service-account token, and authorization-denial families.",
  "display_name": "Kubernetes Audit",
  "vendor": "kubernetes",
  "product": "audit",
  "default_index": "main",
  "default_source": "kubernetes_audit",
  "listener": {
    "source_id": "KUBERNETES_AUDIT",
    "transport": "tcp",
    "port": 20069,
    "env": {
      "SC4S_LISTEN_KUBERNETES_AUDIT_TCP_PORT": "20069",
      "SOURCE_ALL_SET_APPEND": "KUBERNETES_AUDIT"
    }
  },
  "sourcetypes": {
    "rbac_change": "kubernetes:audit",
    "secret_access": "kubernetes:audit",
    "workload_change": "kubernetes:audit",
    "exec_subresource": "kubernetes:audit",
    "authz_forbidden": "kubernetes:audit",
    "impersonated_request": "kubernetes:audit",
    "serviceaccount_token_request": "kubernetes:audit"
  },
  "event_families": [
    {
      "id": "rbac_change",
      "label": "RBAC role/binding changes",
      "match_engine": "pcre",
      "match": "\"apiVersion\"\\s*:\\s*\"audit\\.k8s\\.io/v[0-9]+\".*\"objectRef\".*\"apiGroup\"\\s*:\\s*\"rbac\\.authorization\\.k8s\\.io\"",
      "expected_sourcetype": "kubernetes:audit",
      "primary_id_field": "auditID",
      "required_fields": [
        "auditID",
        "verb",
        "user.username",
        "objectRef.resource",
        "responseStatus.code"
      ],
      "timestamp_fields": [
        "requestReceivedTimestamp",
        "stageTimestamp"
      ]
    },
    {
      "id": "secret_access",
      "label": "Secret object access",
      "match_engine": "pcre",
      "match": "\"apiVersion\"\\s*:\\s*\"audit\\.k8s\\.io/v[0-9]+\".*\"objectRef\".*\"resource\"\\s*:\\s*\"secrets\"",
      "expected_sourcetype": "kubernetes:audit",
      "primary_id_field": "auditID",
      "required_fields": [
        "auditID",
        "verb",
        "user.username",
        "objectRef.namespace",
        "objectRef.name"
      ],
      "timestamp_fields": [
        "requestReceivedTimestamp",
        "stageTimestamp"
      ]
    },
    {
      "id": "workload_change",
      "label": "Workload resource changes",
      "match_engine": "pcre",
      "match": "(?=.*\"apiVersion\"\\s*:\\s*\"audit\\.k8s\\.io/v[0-9]+\")(?=.*\"verb\"\\s*:\\s*\"(create|update|patch|delete)\")(?=.*\"objectRef\".*\"resource\"\\s*:\\s*\"(deployments|daemonsets|statefulsets|pods)\")",
      "expected_sourcetype": "kubernetes:audit",
      "primary_id_field": "auditID",
      "required_fields": [
        "auditID",
        "verb",
        "user.username",
        "objectRef.resource",
        "objectRef.name"
      ],
      "timestamp_fields": [
        "requestReceivedTimestamp",
        "stageTimestamp"
      ]
    },
    {
      "id": "exec_subresource",
      "label": "Pod exec subresource requests",
      "match_engine": "pcre",
      "match": "\"apiVersion\"\\s*:\\s*\"audit\\.k8s\\.io/v[0-9]+\".*\"objectRef\".*\"resource\"\\s*:\\s*\"pods\".*\"subresource\"\\s*:\\s*\"exec\"",
      "expected_sourcetype": "kubernetes:audit",
      "primary_id_field": "auditID",
      "required_fields": [
        "auditID",
        "verb",
        "user.username",
        "objectRef.namespace",
        "objectRef.name",
        "objectRef.subresource"
      ],
      "timestamp_fields": [
        "requestReceivedTimestamp",
        "stageTimestamp"
      ]
    },
    {
      "id": "impersonated_request",
      "label": "Impersonated API requests",
      "match_engine": "pcre",
      "match": "\"apiVersion\"\\s*:\\s*\"audit\\.k8s\\.io/v[0-9]+\".*\"impersonatedUser\"\\s*:",
      "expected_sourcetype": "kubernetes:audit",
      "primary_id_field": "auditID",
      "required_fields": [
        "auditID",
        "verb",
        "user.username",
        "impersonatedUser.username",
        "objectRef.resource",
        "responseStatus.code"
      ],
      "timestamp_fields": [
        "requestReceivedTimestamp",
        "stageTimestamp"
      ]
    },
    {
      "id": "serviceaccount_token_request",
      "label": "ServiceAccount token requests",
      "match_engine": "pcre",
      "match": "\"apiVersion\"\\s*:\\s*\"audit\\.k8s\\.io/v[0-9]+\".*\"objectRef\".*\"resource\"\\s*:\\s*\"serviceaccounts\".*\"subresource\"\\s*:\\s*\"token\"",
      "expected_sourcetype": "kubernetes:audit",
      "primary_id_field": "auditID",
      "required_fields": [
        "auditID",
        "verb",
        "user.username",
        "objectRef.resource",
        "objectRef.subresource",
        "objectRef.name",
        "responseStatus.code"
      ],
      "timestamp_fields": [
        "requestReceivedTimestamp",
        "stageTimestamp"
      ]
    },
    {
      "id": "authz_forbidden",
      "label": "Authorization denied or forbidden requests",
      "match_engine": "pcre",
      "match": "\"apiVersion\"\\s*:\\s*\"audit\\.k8s\\.io/v[0-9]+\".*(\"code\"\\s*:\\s*403|\"reason\"\\s*:\\s*\"Forbidden\"|\"authorization\\.k8s\\.io/decision\"\\s*:\\s*\"forbid\")",
      "expected_sourcetype": "kubernetes:audit",
      "primary_id_field": "auditID",
      "required_fields": [
        "auditID",
        "verb",
        "user.username",
        "responseStatus.code"
      ],
      "timestamp_fields": [
        "requestReceivedTimestamp",
        "stageTimestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "kubernetes",
    "product": "audit",
    "vendor_product": "kubernetes:audit",
    "kubernetes_audit_family": "Derived family: rbac_change, secret_access, workload_change, exec_subresource, impersonated_request, serviceaccount_token_request, or authz_forbidden",
    "kubernetes_audit_id": "Kubernetes auditID request correlation identifier",
    "kubernetes_namespace": "objectRef.namespace where present",
    "kubernetes_resource": "objectRef.resource such as secrets, rolebindings, deployments, pods, or configmaps",
    "kubernetes_resource_name": "objectRef.name target object name",
    "kubernetes_subresource": "objectRef.subresource such as exec",
    "user": "user.username actor",
    "src_user": "user.username actor alias",
    "src": "First sourceIPs value",
    "src_ip": "First sourceIPs value",
    "action": "Native audit verb such as create, get, delete, patch, or update",
    "status": "responseStatus reason/status/code context",
    "signature": "objectRef resource or subresource grouping",
    "signature_id": "auditID",
    "url": "requestURI",
    "marker": "Synthetic fixture marker only",
    "user_agent": "Kubernetes client userAgent string from the audit event",
    "audit_stage": "Kubernetes audit stage such as ResponseComplete",
    "audit_level": "Kubernetes audit policy level such as Metadata, Request, or RequestResponse",
    "response_code": "responseStatus.code HTTP/API status code preserved for read-back auditability",
    "authorization_decision": "annotations.authorization.k8s.io/decision value such as allow or forbid where present",
    "impersonated_user": "impersonatedUser.username when Kubernetes API impersonation is used",
    "request_kind": "requestObject.kind where audit policy captures request bodies, for example TokenRequest",
    "request_api_version": "requestObject.apiVersion where audit policy captures request bodies",
    "token_audience": "TokenRequest audiences for service-account token issuance; fixture uses safe example audience only",
    "token_expiration_seconds": "TokenRequest requested expirationSeconds",
    "bound_object_kind": "TokenRequest boundObjectRef.kind where present",
    "bound_object_name": "TokenRequest boundObjectRef.name where present"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-kubernetes_audit.conf",
      "sc4s/env.example"
    ],
    "splunk": [
