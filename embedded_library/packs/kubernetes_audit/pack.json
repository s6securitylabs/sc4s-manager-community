    ],
    "docs": [
      "README.md",
      "docs/kubernetes_audit_reduction_candidates.csv",
      "validation/preflight-2026-06-07.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tcp_syslog",
      "label": "TCP syslog / Kubernetes audit JSON relay",
      "transport": "tcp",
      "recommended": true,
      "default_port": 20069,
      "notes": "Dedicated TCP listener for one Kubernetes audit JSON event per line from file, webhook, Fluent Bit, Cribl, or another relay.",
      "syslog_protocol": "tcp_syslog",
      "framing": "line_delimited",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "json"
    },
    {
      "id": "rfc5425_tls",
      "label": "TLS/RFC5425 syslog",
      "transport": "tls",
      "recommended": false,
      "default_port": 20069,
      "notes": "Preferred for production if the local SC4S deployment provisions TLS for this source.",
      "syslog_protocol": "rfc5425",
      "framing": "octet_counted",
      "envelope": "ietf_rfc5424",
      "payload_format": "json"
    }
  ],
  "recommended_transport": "tcp_syslog",
  "source_log_version": {
    "name": "Kubernetes audit.k8s.io/v1 Event records",
    "min": "audit.k8s.io/v1",
    "max": null,
    "notes": "Grounded in public Kubernetes audit documentation and synthetic-equivalent fixtures; local audit policy level and collector wrapping must be validated before promotion."
  },
