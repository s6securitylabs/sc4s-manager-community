{
  "schema_version": "0.1",
  "id": "hermes_agent_audit",
  "version": "0.1.0",
  "url": "https://hermes-agent.nousresearch.com/docs",
  "description": "Curated SecHub Resources pack for Hermes Agent gateway/runtime audit events, with analyst dashboards for authentication, foreign IP, channel routing, tool execution, credential/provider risk, approvals, and blocked-action review.",
  "display_name": "Hermes Agent Audit Logs",
  "vendor": "nousresearch",
  "product": "hermes_agent",
  "default_index": "netauth",
  "default_source": "hermes_agent_audit",
  "listener": {
    "source_id": "HERMES_AGENT_AUDIT",
    "transport": "tcp",
    "port": 20131,
    "env": {
      "SC4S_LISTEN_HERMES_AGENT_AUDIT_TCP_PORT": "20131",
      "SOURCE_ALL_SET_APPEND": "HERMES_AGENT_AUDIT"
    }
  },
  "sourcetypes": {
    "identity_session": "hermes:agent:audit",
    "gateway_channel": "hermes:agent:audit",
    "tool_execution": "hermes:agent:audit",
    "credential_secret": "hermes:agent:audit",
    "admin_config": "hermes:agent:audit",
    "safety_policy": "hermes:agent:audit"
  },
  "event_families": [
    {
      "id": "identity_session",
      "label": "Hermes/OpenClaw identity and session events",
      "match_engine": "pcre",
      "match": "(login|logout|session|oauth|sso|auth)",
      "expected_sourcetype": "hermes:agent:audit",
      "primary_id_field": "event_id",
      "required_fields": [
        "timestamp",
        "event.action",
        "actor.user.name",
        "client.ip"
      ],
      "timestamp_fields": [
        "timestamp",
        "@timestamp",
        "time"
      ]
    },
    {
      "id": "gateway_channel",
      "label": "Gateway channel binding and delivery-route changes",
      "match_engine": "pcre",
      "match": "(channel|handoff|delivery|telegram|slack|signal|webhook)",
      "expected_sourcetype": "hermes:agent:audit",
      "primary_id_field": "channel_id",
      "required_fields": [
        "timestamp",
        "event.action",
        "channel.id",
        "platform"
      ],
      "timestamp_fields": [
        "timestamp",
        "@timestamp",
        "time"
      ]
    },
    {
      "id": "tool_execution",
      "label": "Agent tool execution and side-effect requests",
      "match_engine": "pcre",
      "match": "(tool|terminal|browser|file|cron|process|delegate)",
      "expected_sourcetype": "hermes:agent:audit",
      "primary_id_field": "tool.name",
      "required_fields": [
        "timestamp",
        "event.action",
        "tool.name",
        "actor.user.name"
      ],
      "timestamp_fields": [
        "timestamp",
        "@timestamp",
        "time"
      ]
    },
    {
      "id": "credential_secret",
      "label": "Credential, token, secret, and provider configuration events",
      "match_engine": "pcre",
      "match": "(credential|token|secret|provider|model|api_key)",
      "expected_sourcetype": "hermes:agent:audit",
      "primary_id_field": "credential.id",
      "required_fields": [
        "timestamp",
        "event.action",
        "actor.user.name"
      ],
      "timestamp_fields": [
        "timestamp",
        "@timestamp",
        "time"
      ]
    },
    {
      "id": "admin_config",
      "label": "Administrative configuration, profile, skill, cron, and plugin changes",
      "match_engine": "pcre",
      "match": "(config|profile|skill|plugin|cron|admin)",
      "expected_sourcetype": "hermes:agent:audit",
      "primary_id_field": "object.id",
      "required_fields": [
        "timestamp",
        "event.action",
        "actor.user.name",
        "object.type"
      ],
      "timestamp_fields": [
        "timestamp",
        "@timestamp",
        "time"
      ]
    },
    {
      "id": "safety_policy",
      "label": "Safety, prompt-injection, permission, and blocked-action events",
      "match_engine": "pcre",
      "match": "(safety|policy|blocked|prompt_injection|permission|approval)",
      "expected_sourcetype": "hermes:agent:audit",
      "primary_id_field": "rule.id",
      "required_fields": [
        "timestamp",
        "event.action",
        "rule.id"
      ],
      "timestamp_fields": [
        "timestamp",
        "@timestamp",
        "time"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "nousresearch or openclaw depending on producer",
    "product": "hermes_agent, hermes_gateway, or openclaw",
    "vendor_product": "nousresearch:hermes_agent",
    "hermes_openclaw_family": "Derived SOC family from event.action, event.category, component, and marker",
    "event_id": "Source event identifier where present",
    "trace_id": "Request/run trace identifier where present",
    "request_id": "Gateway/API request identifier",
    "run_id": "Hermes agent run identifier",
    "session_id": "Human/agent session identifier",
    "profile": "Hermes profile name where present",
    "component": "gateway, agent, scheduler, tool, provider, openclaw bridge, or channel adapter",
    "actor_user": "Authenticated human or service actor",
    "user": "Actor alias",
    "src_user": "Actor alias",
    "target_user": "Affected user/bot/account where present",
    "src_ip": "Client or upstream source IP",
    "src": "Source IP alias",
    "country": "GeoIP country/region derived downstream, not trusted source truth",
    "user_agent": "HTTP/API user agent",
    "platform": "telegram, slack, signal, local, api, web, or other channel",
    "channel_id": "Messaging channel/thread identifier; sensitive deployment metadata",
    "thread_id": "Messaging thread/topic identifier",
    "event_action": "Source action token",
    "action": "Action alias",
    "object": "Affected channel, skill, profile, cron job, tool, credential, provider, or policy object",
    "object_type": "Affected object class",
    "tool_name": "Hermes tool invoked",
    "tool_result": "Outcome/status for tool invocation",
    "provider": "Model/provider/credential provider label",
    "model": "Model name where present",
    "risk_reason": "Analyst-readable reason for risk/blocked/policy event",
    "policy_decision": "allow, block, require_approval, redact, or similar policy result",
    "marker": "Synthetic fixture marker only",
    "runtime": "Runtime side such as hermes-gateway, hermes-agent, legacy-openclaw-gateway, openclaw-browser, cron, or collector",
    "legacy_component": "Legacy OpenClaw component when the event was sourced from pre-Hermes config/logs",
    "gateway_port": "Gateway/control port if logged; publish only non-secret listener metadata and prefer local/internal addresses",
    "gateway_bind": "Gateway bind scope such as loopback/local/private/public; analysts should review anything beyond loopback/private",
    "owner_allowlist_state": "Summary state for owner/chat allowlists without publishing real IDs in public fixtures",
    "require_mention": "Whether group/channel use requires bot mention or equivalent explicit trigger",
    "dual_polling_risk": "True/reason when Hermes and legacy OpenClaw may both poll the same messaging token/channel",
    "migration_phase": "discovered, dry_run, cutover, rollback, validated, or blocked",
    "hook_name": "OpenClaw/Hermes internal hook such as command-logger, session-memory, or compaction-notifier"
  },
