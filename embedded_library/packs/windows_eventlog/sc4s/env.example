# Microsoft Windows Event Log relay profile example.
# Use a dedicated listener/source tag so Windows Event XML does not steal unrelated XML/syslog logs.
SC4S_LISTEN_WINDOWS_EVENTLOG_TCP_PORT=20063
SOURCE_ALL_SET_APPEND=WINDOWS_EVENTLOG
# Send one-line Windows Event XML records from WEF/NXLog/Cribl/Fluent Bit relay to the dedicated listener.
