{
  "schema_version": "0.1",
  "id": "nginx_apache_http",
  "version": "0.1.4",
  "url": "https://nginx.org/en/docs/http/ngx_http_log_module.html",
  "description": "Curated SecHub Resources SC4S pack for common Nginx and Apache httpd HTTP access and selected error-log relay lines.",
  "display_name": "Nginx / Apache HTTP access and error logs",
  "vendor": "nginx_apache",
  "product": "http_access_logs",
  "default_index": "netops",
  "default_source": "nginx_apache_http",
  "listener": {
    "source_id": "NGINX_APACHE_HTTP",
    "transport": "tcp",
    "port": 20075,
    "env": {
      "SC4S_LISTEN_NGINX_APACHE_HTTP_TCP_PORT": "20075",
      "SOURCE_ALL_SET_APPEND": "NGINX_APACHE_HTTP"
    }
  },
  "sourcetypes": {
    "nginx_combined": "nginx:access:combined",
    "apache_common": "apache:httpd:access:common",
    "apache_combined": "apache:httpd:access:combined",
    "nginx_error": "nginx:error",
    "apache_error": "apache:httpd:error"
  },
  "event_families": [
    {
      "id": "nginx_combined",
      "label": "Nginx combined access log",
      "match_engine": "pcre",
      "match": "SC4S_NGINX_APACHE_HTTP_TEST_NGINX_COMBINED_",
      "expected_sourcetype": "nginx:access:combined",
      "primary_id_field": "marker",
      "required_fields": [
        "src_ip",
        "http_method",
        "uri_path",
        "status"
      ],
      "timestamp_fields": [
        "bracketed access-log timestamp"
      ]
    },
    {
      "id": "apache_common",
      "label": "Apache httpd Common Log Format",
      "match_engine": "pcre",
      "match": "SC4S_NGINX_APACHE_HTTP_TEST_APACHE_COMMON_",
      "expected_sourcetype": "apache:httpd:access:common",
      "primary_id_field": "marker",
      "required_fields": [
        "src_ip",
        "http_method",
        "uri_path",
        "status"
      ],
      "timestamp_fields": [
        "bracketed access-log timestamp"
      ]
    },
    {
      "id": "apache_combined",
      "label": "Apache httpd Combined Log Format",
      "match_engine": "pcre",
      "match": "SC4S_NGINX_APACHE_HTTP_TEST_APACHE_COMBINED_",
      "expected_sourcetype": "apache:httpd:access:combined",
      "primary_id_field": "marker",
      "required_fields": [
        "src_ip",
        "http_method",
        "uri_path",
        "status"
      ],
      "timestamp_fields": [
        "bracketed access-log timestamp"
      ]
    },
    {
      "id": "nginx_error",
      "label": "Nginx error log",
      "match_engine": "pcre",
      "match": "SC4S_NGINX_APACHE_HTTP_TEST_NGINX_ERROR_",
      "expected_sourcetype": "nginx:error",
      "primary_id_field": "marker",
      "required_fields": [
        "error_level",
        "error_message",
        "client_ip"
      ],
      "timestamp_fields": [
        "leading Nginx error-log timestamp"
      ]
    },
    {
      "id": "apache_error",
      "label": "Apache httpd error log",
      "match_engine": "pcre",
      "match": "SC4S_NGINX_APACHE_HTTP_TEST_APACHE_ERROR_",
      "expected_sourcetype": "apache:httpd:error",
      "primary_id_field": "marker",
      "required_fields": [
        "module",
        "error_level",
        "error_message",
        "client_ip"
      ],
      "timestamp_fields": [
        "bracketed Apache error-log timestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "nginx or apache, depending on routed sourcetype",
    "product": "http_server or httpd, depending on routed sourcetype",
    "vendor_product": "nginx:http_server or apache:httpd",
    "src_ip": "remote client IP/host token from CLF/combined record",
    "src": "alias of src_ip",
    "ident": "RFC1413 ident token where present, usually '-'",
    "user": "authenticated user token where present, '-' means absent/unknown",
    "http_method": "HTTP request method token",
    "uri_path": "request target/path token from access log",
    "url": "alias of uri_path",
    "http_version": "HTTP protocol version token",
    "status": "HTTP response status code",
    "bytes": "documented response byte count token, '-' when unavailable",
    "bytes_out": "numeric byte count when present",
    "http_referrer": "Combined-format referrer header token",
    "http_user_agent": "Combined-format user-agent header token",
    "request": "quoted HTTP request line as raw context where available",
