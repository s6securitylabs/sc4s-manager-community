    "marker": "synthetic fixture marker only",
    "error_level": "Nginx/Apache error severity token where present",
    "error_message": "Error-log message text after product prefix/module context",
    "module": "Apache module token in error logs",
    "error_code": "Apache AHnnnnn error code where present",
    "client_ip": "Client IP token in Nginx/Apache error logs",
    "client_port": "Apache client source port where present",
    "server": "Nginx server-name context where present",
    "host_header": "Nginx Host header context where present",
    "connection_id": "Nginx per-connection identifier where present",
    "pid": "Process identifier where present",
    "tid": "Thread identifier where present"
  },
