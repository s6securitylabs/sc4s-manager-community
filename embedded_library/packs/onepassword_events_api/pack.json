{
  "schema_version": "0.1",
  "id": "onepassword_events_api",
  "version": "0.1.1",
  "url": "https://developer.1password.com/docs/events-api/reference/",
  "description": "Curated SecHub Resources SC4S pack for 1Password Events API audit, item-usage, and sign-in-attempt records relayed as one JSON object per line.",
  "display_name": "1Password Events API",
  "vendor": "1password",
  "product": "events_api",
  "default_index": "netauth",
  "default_source": "onepassword_events_api",
  "listener": {
    "source_id": "1PASSWORD_EVENTS_API",
    "transport": "tcp",
    "port": 20098,
    "env": {
      "SC4S_LISTEN_1PASSWORD_EVENTS_API_TCP_PORT": "20098",
      "SOURCE_ALL_SET_APPEND": "1PASSWORD_EVENTS_API"
    }
  },
  "sourcetypes": {
    "audit_event": "1password:events",
    "item_usage": "1password:events",
    "sign_in_attempt": "1password:events"
  },
  "event_families": [
    {
      "id": "audit_event",
      "label": "1Password audit events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"join\\\".*\\\"object_type\\\"\\s*:\\s*\\\"gm\\\"|\\\"object_type\\\"\\s*:\\s*\\\"gm\\\".*\\\"action\\\"\\s*:\\s*\\\"join\\\"",
      "expected_sourcetype": "1password:events",
      "primary_id_field": "uuid",
      "required_fields": [
        "uuid",
        "timestamp",
        "action",
        "object_type",
        "actor_details"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "item_usage",
      "label": "1Password item usage events",
      "match_engine": "pcre",
      "match": "\\\"action\\\"\\s*:\\s*\\\"secure-copy\\\"",
      "expected_sourcetype": "1password:events",
      "primary_id_field": "uuid",
      "required_fields": [
        "uuid",
        "timestamp",
        "action",
        "item_uuid",
        "vault_uuid",
        "user"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "sign_in_attempt",
      "label": "1Password sign-in attempt events",
      "match_engine": "pcre",
      "match": "\\\"category\\\"\\s*:\\s*\\\"firewall_failed\\\"",
      "expected_sourcetype": "1password:events",
      "primary_id_field": "uuid",
      "required_fields": [
        "uuid",
        "timestamp",
        "category",
        "type",
        "target_user"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "1password",
    "product": "events_api",
    "vendor_product": "1password:events_api",
    "onepassword_event_family": "Derived family: audit_event, item_usage, or sign_in_attempt",
    "uuid": "1Password event UUID",
    "event_id": "Alias of uuid",
    "timestamp": "Event timestamp in UTC",
    "action": "Audit or item-usage action token",
