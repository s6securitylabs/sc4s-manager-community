        "fallback_time_mode": "source_local_time_requires_timezone",
        "fallback_timezone": null,
        "requires_source_timezone_when_fields_missing": [
          "Generated Time",
          "Receive Time"
        ],
        "notes": "PAN-OS CSV timestamps normally omit timezone. Headerless fixtures and Splunk props use Receive Time as the first payload timestamp; prefer timezone-qualified RFC5424/RFC5425 header time in production when present. The SC4S parser preserves payload timestamps without reparsing them, and Splunk payload-time parsing requires explicitly configured/recorded source timezone."
      },
      "field_delimiting": {
        "style": "positional_csv",
        "field_separator": ",",
        "quote_character": "\"",
        "escape_policy": "PAN-OS default syslog CSV; preserve empty FUTURE_USE fields and trailing fields",
        "allows_empty_fields": true,
        "notes": "Field positions are family-specific. Do not collapse delimiters or convert to JSON when targeting the Splunk TA."
      },
