{
  "schema_version": "0.1",
  "id": "vpn_daemon_logs",
  "version": "0.1.6",
  "url": "https://github.com/OpenVPN/openvpn",
  "description": "Curated SecHub Resources SC4S pack for narrow OpenVPN and strongSwan daemon syslog relay records with fixture-backed connection, verification, session/pool assignment, authentication-failure, and tunnel up/down families.",
  "display_name": "VPN daemon logs",
  "vendor": "vpn_daemon",
  "product": "openvpn_strongswan",
  "default_index": "netauth",
  "default_source": "vpn_daemon_logs",
  "listener": {
    "source_id": "VPN_DAEMON_LOGS",
    "transport": "tcp",
    "port": 20078,
    "env": {
      "SC4S_LISTEN_VPN_DAEMON_LOGS_TCP_PORT": "20078",
      "SOURCE_ALL_SET_APPEND": "VPN_DAEMON_LOGS"
    }
  },
  "sourcetypes": {
    "openvpn_peer_connection": "vpn:openvpn:peer",
    "openvpn_certificate_verify": "vpn:openvpn:verify",
    "openvpn_session": "vpn:openvpn:session",
    "openvpn_auth_failed": "vpn:openvpn:auth",
    "strongswan_updown": "vpn:strongswan:updown"
  },
  "event_families": [
    {
      "id": "openvpn_peer_connection",
      "label": "OpenVPN peer connection initiated",
      "match_engine": "pcre",
      "match": "openvpn\\[\\d+\\]: .*Peer Connection Initiated with \\[AF_INET\\]",
      "expected_sourcetype": "vpn:openvpn:peer",
      "primary_id_field": "client_context",
      "required_fields": [
        "client_context",
        "src_ip",
        "src_port",
        "action"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "openvpn_certificate_verify",
      "label": "OpenVPN certificate verification OK",
      "match_engine": "pcre",
      "match": "openvpn\\[\\d+\\]: .*VERIFY OK: depth=\\d+,",
      "expected_sourcetype": "vpn:openvpn:verify",
      "primary_id_field": "certificate_subject",
      "required_fields": [
        "cert_depth",
        "certificate_subject",
        "action"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "openvpn_session",
      "label": "OpenVPN session initialized, virtual IP assigned, or pool return logged",
      "match_engine": "pcre",
      "match": "openvpn\\[\\d+\\]: .*(Initialization Sequence Completed|MULTI: primary virtual IP|MULTI_sva: pool returned)",
      "expected_sourcetype": "vpn:openvpn:session",
      "primary_id_field": "client_context",
      "required_fields": [
        "action",
        "result"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "openvpn_auth_failed",
      "label": "OpenVPN authentication or cipher negotiation failure",
      "match_engine": "pcre",
      "match": "openvpn\\[\\d+\\]: .*AUTH_FAILED",
      "expected_sourcetype": "vpn:openvpn:auth",
      "primary_id_field": "client_context",
      "required_fields": [
        "client_context",
        "reason",
        "action",
        "result"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "strongswan_updown",
      "label": "strongSwan _updown tunnel create/delete",
      "match_engine": "pcre",
      "match": "vpn: [+-] \\S+  \\d+\\.\\d+\\.\\d+\\.\\d+ -- \\d+\\.\\d+\\.\\d+\\.\\d+ == \\S+",
      "expected_sourcetype": "vpn:strongswan:updown",
      "primary_id_field": "peer_id",
      "required_fields": [
        "vendor_raw_action",
        "peer_id",
        "peer_ip",
        "local_ip",
        "tunnel_network"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "VPN daemon source family",
    "product": "OpenVPN or strongSwan component identity",
    "vendor_product": "vpn_daemon:<component>",
    "syslog_timestamp": "RFC3164-style payload timestamp",
    "host": "Relay host token",
    "process_id": "OpenVPN process ID where present",
    "client_context": "OpenVPN client/common-name and remote endpoint context",
    "peer_id": "strongSwan peer identity",
    "peer_ip": "strongSwan peer IP",
    "local_ip": "strongSwan local endpoint IP",
    "tunnel_network": "strongSwan protected/tunnel network",
    "vendor_raw_action": "Raw strongSwan _updown action token + or -",
    "action": "Fixture-backed analyst action",
    "result": "Derived success/failure/end result",
    "signature": "Family grouping label",
    "signature_id": "Raw template/action identifier",
    "src": "Alias for source endpoint",
    "src_ip": "Source endpoint or tunnel IP",
    "src_port": "Source endpoint port",
    "dest": "Alias for local endpoint",
    "dest_ip": "Local endpoint IP",
    "user": "Peer/client identity where present",
    "certificate_subject": "OpenVPN certificate subject",
    "cert_depth": "OpenVPN certificate verification depth",
    "tunnel_ip": "OpenVPN assigned virtual IP",
    "reason": "OpenVPN AUTH_FAILED reason",
    "marker": "Synthetic fixture marker only",
    "pool_ipv4": "OpenVPN MULTI_sva pool-return IPv4 assignment where present",
    "pool_ipv6": "OpenVPN MULTI_sva pool-return IPv6 state/value where present"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-vpn_daemon_logs.conf",
      "sc4s/env.example"
    ],
    "splunk": [
