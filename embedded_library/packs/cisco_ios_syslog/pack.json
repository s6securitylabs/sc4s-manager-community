  },
  "sourcetypes": {
    "ios_syslog": "cisco:ios"
  },
  "event_families": [
    {
      "id": "ios_syslog",
      "label": "Cisco IOS / IOS-XE %IDENTIFIER-SEVERITY-MNEMONIC syslog messages",
      "match_engine": "pcre",
      "match": "%[A-Z0-9_]+-[0-7]-[A-Z0-9_]+:",
      "expected_sourcetype": "cisco:ios",
      "primary_id_field": "cisco_mnemonic",
      "required_fields": [
        "cisco_identifier",
        "cisco_severity",
        "cisco_mnemonic"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Cisco",
    "product": "IOS",
    "vendor_product": "cisco:ios",
    "cisco_identifier": "Cisco facility/identifier token before severity",
    "cisco_severity": "Cisco numeric severity 0-7",
    "cisco_mnemonic": "Cisco mnemonic after severity",
    "cisco_message": "message body after Cisco token",
    "severity": "Cisco numeric severity value surfaced for Splunk/CIM severity review",
    "severity_label": "Cisco numeric severity label",
    "signature": "identifier-mnemonic",
    "signature_id": "identifier-mnemonic",
    "timesync_marker": "Cisco timestamp status marker such as * or . when present",
    "interface": "interface from LINK/LINEPROTO examples",
    "interface_state": "interface state from LINK examples",
    "line_protocol_state": "line protocol state from LINEPROTO examples",
    "config_source": "configuration source token from CONFIG_I examples, such as console",
    "terminal": "terminal or line token from CONFIG_I examples, such as vty0",
    "user": "user from config/login examples",
    "login_result": "raw Cisco login outcome token from SEC_LOGIN examples, such as Success or failed",
    "src": "analyst source alias derived from src_ip for login examples",
    "src_ip": "source IP from login examples",
    "dest_port": "local port from login examples",
    "action": "conservative action for selected fixtures",
    "login_reason": "raw Cisco login failure reason bracket when the SEC_LOGIN message carries one"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-cisco_ios_syslog.conf",
      "sc4s/env.example"
    ],
