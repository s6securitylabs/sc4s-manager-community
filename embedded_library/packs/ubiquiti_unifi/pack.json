{
  "schema_version": "0.1",
  "id": "ubiquiti_unifi",
  "version": "0.1.4",
  "url": "https://help.ui.com/hc/en-us/categories/6583256751383-UniFi",
  "description": "Curated SecHub Resources SC4S pack for Ubiquiti UniFi network telemetry telemetry with operator dashboard.",
  "display_name": "Ubiquiti UniFi network telemetry",
  "vendor": "ubiquiti",
  "product": "unifi",
  "default_index": "netops",
  "default_source": "ubiquiti_unifi",
  "listener": {
    "source_id": "UBIQUITI_UNIFI",
    "transport": "tcp",
    "port": 20086,
    "env": {
      "SC4S_LISTEN_UBIQUITI_UNIFI_TCP_PORT": "20086",
      "SOURCE_ALL_SET_APPEND": "UBIQUITI_UNIFI"
    }
  },
  "sourcetypes": {
    "firewall": "ubiquiti:unifi:firewall",
    "client": "ubiquiti:unifi:client",
    "admin": "ubiquiti:unifi:admin",
    "device": "ubiquiti:unifi:device",
    "threat": "ubiquiti:unifi:threat",
    "vpn": "ubiquiti:unifi:vpn"
  },
  "event_families": [
    {
      "id": "firewall",
      "label": "UniFi firewall/security rule events",
      "match_engine": "pcre",
      "match": "firewall event|SC4S_UNIFI_TEST_FIREWALL_",
      "expected_sourcetype": "ubiquiti:unifi:firewall",
      "primary_id_field": "rule",
      "required_fields": [
        "action",
        "src",
        "dst",
        "proto"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "client",
      "label": "UniFi client association events",
      "match_engine": "pcre",
      "match": "client (connected|disconnected)|SC4S_UNIFI_TEST_CLIENT_",
      "expected_sourcetype": "ubiquiti:unifi:client",
      "primary_id_field": "mac",
      "required_fields": [
        "client",
        "mac",
        "ap",
        "ssid"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "admin",
      "label": "UniFi admin authentication and control-plane events",
      "match_engine": "pcre",
      "match": "admin login|SC4S_UNIFI_TEST_ADMIN_",
      "expected_sourcetype": "ubiquiti:unifi:admin",
      "primary_id_field": "user",
      "required_fields": [
        "user",
        "src",
        "result"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "device",
      "label": "UniFi device inventory and lifecycle events",
      "match_engine": "pcre",
      "match": "device (adopted|disconnected|provisioned)|SC4S_UNIFI_TEST_DEVICE_",
      "expected_sourcetype": "ubiquiti:unifi:device",
      "primary_id_field": "device",
      "required_fields": [
        "device",
        "mac",
        "ip"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "threat",
      "label": "UniFi threat/security detections",
      "match_engine": "pcre",
      "match": "threat detected|SC4S_UNIFI_TEST_THREAT_",
      "expected_sourcetype": "ubiquiti:unifi:threat",
      "primary_id_field": "signature",
      "required_fields": [
        "signature",
        "severity",
        "src",
        "dst"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    },
    {
      "id": "vpn",
      "label": "UniFi VPN/session events",
      "match_engine": "pcre",
      "match": "vpn session|SC4S_UNIFI_TEST_VPN_",
      "expected_sourcetype": "ubiquiti:unifi:vpn",
      "primary_id_field": "user",
      "required_fields": [
        "user",
        "src"
      ],
      "timestamp_fields": [
        "syslog timestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "ubiquiti",
    "product": "unifi",
    "src": "source IP/client",
