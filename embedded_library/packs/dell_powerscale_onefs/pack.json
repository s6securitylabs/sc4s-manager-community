      "syslog_protocol": "udp_syslog",
      "framing": "datagram",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "json"
    }
  ],
  "recommended_transport": "tls_rfc5425",
  "source_log_version": {
    "name": "Dell PowerScale OneFS audit forwarding",
