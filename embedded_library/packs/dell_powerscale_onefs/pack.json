{
  "schema_version": "0.1",
  "id": "dell_powerscale_onefs",
  "version": "0.1.3",
  "url": "https://www.dell.com/support/kbdoc/en-us/000020901/how-to-view-audit-logs-on-onefs",
  "description": "Curated SecHub Resources SC4S pack for Dell PowerScale OneFS audit forwarding. Provides conservative protocol/config audit routing and explicit evidence gaps pending real OneFS syslog capture.",
  "display_name": "Dell PowerScale OneFS audit logging",
  "vendor": "dell",
  "product": "powerscale-onefs",
  "default_index": "infraops",
  "default_source": "dell_powerscale_onefs",
  "listener": {
    "source_id": "DELL_POWERSCALE_ONEFS",
    "transport": "tls",
    "port": 20092,
    "env": {
      "SC4S_LISTEN_DELL_POWERSCALE_ONEFS_TLS_PORT": "20092",
      "SOURCE_ALL_SET_APPEND": "DELL_POWERSCALE_ONEFS"
    }
  },
  "sourcetypes": {
    "protocol": "dell:powerscale:onefs:protocol",
    "config": "dell:powerscale:onefs:config"
  },
  "event_families": [
    {
      "id": "protocol",
      "label": "OneFS protocol audit events",
      "match_engine": "pcre",
      "match": "\\\"protocol\\\"\\s*:",
      "expected_sourcetype": "dell:powerscale:onefs:protocol",
      "primary_id_field": "detailType",
      "required_fields": [
        "protocol",
        "eventType"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "config",
      "label": "OneFS configuration audit events",
      "match_engine": "pcre",
      "match": "\\\"topic\\\"\\s*:\\s*\\\"config\\\"",
      "expected_sourcetype": "dell:powerscale:onefs:config",
      "primary_id_field": "detailType",
      "required_fields": [
        "topic",
        "eventType"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Dell",
    "product": "Dell PowerScale OneFS audit logging",
    "vendor_product": "dell:powerscale-onefs",
    "protocol": "OneFS protocol audit protocol token preserved from JSON payload.",
    "topic": "OneFS audit topic such as config, preserved from JSON payload where present.",
    "eventType": "Raw OneFS audit event type preserved before aliasing to action.",
    "detailType": "Raw granular OneFS audit detail type preserved before aliasing to signature.",
    "action": "Analyst-facing alias sourced from eventType by Splunk props.",
    "signature": "Analyst-facing alias sourced from detailType by Splunk props.",
    "clientIPAddr": "Raw OneFS client IP field preserved before aliasing to src.",
    "src": "Analyst-facing source endpoint alias sourced from clientIPAddr for protocol audit events.",
    "userID": "Raw OneFS user identifier from protocol audit events.",
    "userSID": "Raw OneFS user SID from protocol audit events.",
    "user": "Analyst-facing user alias sourced from userID where available.",
    "actor": "Configuration audit actor context preserved from JSON payload.",
    "object": "Configuration audit object context preserved from JSON payload.",
    "fileName": "Protocol audit file/object path preserved from JSON payload.",
    "newFileName": "Protocol audit renamed destination path preserved from JSON payload.",
    "zoneName": "OneFS access zone context preserved from JSON payload.",
    "marker": "Synthetic fixture marker used only for replay/read-back requirements checks."
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-dell_powerscale_onefs.conf",
      "sc4s/env.example"
    ],
