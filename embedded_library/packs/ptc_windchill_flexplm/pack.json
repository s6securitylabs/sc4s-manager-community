        "src_ip",
        "uri_path",
        "query_string"
      ],
      "timestamp_fields": [
        "outer log4j timestamp",
        "embedded Windchill event timestamp"
      ]
    },
    {
      "id": "gateway_command_execution",
      "label": "Windchill gateway command or file-read style request",
      "match_engine": "pcre",
      "match": "c=whoami|run\\?p=|\\.jsp\\?c=|\\.jsp\\?p=",
      "expected_sourcetype": "log4j",
      "primary_id_field": "signature_id",
      "required_fields": [
        "logger",
        "src_ip",
        "uri_path",
        "query_string",
        "status"
      ],
      "timestamp_fields": [
        "outer log4j timestamp",
