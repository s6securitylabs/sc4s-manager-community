{
  "schema_version": "0.1",
  "id": "atlassian_cloud_audit",
  "version": "0.1.2",
  "url": "https://developer.atlassian.com/cloud/admin/organization/rest/api-group-events/",
  "description": "Curated SecHub Resources SC4S pack for Atlassian Cloud Jira, Confluence, and organization audit API JSON records relayed as one event per line.",
  "display_name": "Atlassian Cloud Audit",
  "vendor": "atlassian",
  "product": "cloud_audit",
  "default_index": "gitops",
  "default_source": "atlassian_cloud_audit",
  "listener": {
    "source_id": "ATLASSIAN_CLOUD_AUDIT",
    "transport": "tcp",
    "port": 20100,
    "env": {
      "SC4S_LISTEN_ATLASSIAN_CLOUD_AUDIT_TCP_PORT": "20100",
      "SOURCE_ALL_SET_APPEND": "ATLASSIAN_CLOUD_AUDIT"
    }
  },
  "sourcetypes": {
    "jira_cloud_audit": "atlassian:cloud:audit:json",
    "confluence_cloud_audit": "atlassian:cloud:audit:json",
    "organization_audit_event": "atlassian:cloud:audit:json"
  },
  "event_families": [
    {
      "id": "jira_cloud_audit",
      "label": "Jira Cloud audit records",
      "match_engine": "pcre",
      "match": "\\\"source_product\\\"\\s*:\\s*\\\"jira_cloud\\\"",
      "expected_sourcetype": "atlassian:cloud:audit:json",
      "primary_id_field": "id",
      "required_fields": [
        "id",
        "created",
        "summary",
        "category",
        "authorAccountId",
        "remoteAddress"
      ],
      "timestamp_fields": [
        "created"
      ]
    },
    {
      "id": "confluence_cloud_audit",
      "label": "Confluence Cloud audit records",
      "match_engine": "pcre",
      "match": "\\\"source_product\\\"\\s*:\\s*\\\"confluence_cloud\\\"",
      "expected_sourcetype": "atlassian:cloud:audit:json",
      "primary_id_field": "marker",
      "required_fields": [
        "creationDate",
        "summary",
        "category",
        "author",
        "remoteAddress",
        "affectedObject"
      ],
      "timestamp_fields": [
        "creationDate"
      ]
    },
    {
      "id": "organization_audit_event",
      "label": "Atlassian Admin organization audit events",
      "match_engine": "pcre",
      "match": "\\\"source_product\\\"\\s*:\\s*\\\"atlassian_admin_org\\\"",
      "expected_sourcetype": "atlassian:cloud:audit:json",
      "primary_id_field": "id",
      "required_fields": [
        "id",
        "type",
        "attributes",
        "message"
      ],
      "timestamp_fields": [
        "attributes.time"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "atlassian",
    "product": "cloud_audit",
    "vendor_product": "atlassian:cloud_audit",
    "source_product": "Collector-supplied or preserved source-mode discriminator: jira_cloud, confluence_cloud, or atlassian_admin_org",
    "atlassian_audit_family": "Derived family for Jira, Confluence, or organization audit events",
    "id": "Native event id where provided",
    "event_id": "Event id alias for read-back/dedupe",
    "created": "Jira audit timestamp",
    "creationDate": "Confluence audit timestamp",
    "attributes.time": "Atlassian Admin organization event timestamp",
    "summary": "Jira/Confluence audit summary",
    "category": "Jira/Confluence audit category",
    "action": "Derived audit action/signature token",
