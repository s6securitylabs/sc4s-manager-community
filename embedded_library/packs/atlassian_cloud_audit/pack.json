      "known_limitations": [
        "No live Atlassian API relay replay/read-back captured.",
        "Only collector-relayed one-line JSON records are fixture-backed; native API pages and arrays need collector splitting.",
        "Coverage is narrow and does not prove complete Atlassian Cloud product audit coverage."
      ],
      "event_boundary": "one Jira, Confluence, or organization audit JSON object per physical line after API page/array or JSON:API envelope unwrapping; native result pages and arrays are collector input, not the SC4S event boundary",
      "events_per_file_or_message": "one source audit record per relayed syslog/message line; API pages, paginated result sets, and event-stream batches may contain many records but collector/relay logic must split before SC4S",
      "uniqueness_or_multiline": "fixture-backed records are unique single-line JSON events; multiline JSON, batched arrays, and nested collector envelopes require local normalization before relay",
      "field_delimiting_or_escaping": "JSON object syntax with standard quoting/escaping; preserve nested changedValues, associatedItems, affectedObject, attributes.actor, attributes.location, and attributes.object context without lossy flattening",
      "timestamp_timezone": "Jira created, Confluence creationDate, and organization attributes.time fixture fields are timezone-qualified UTC/ISO-8601 values; syslog wrapper time is relay metadata only until local read-back verifies precedence"
    }
  ],
