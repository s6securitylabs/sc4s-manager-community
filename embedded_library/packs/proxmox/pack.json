{
  "schema_version": "0.1",
  "id": "proxmox",
  "version": "0.1.3",
  "url": "https://www.proxmox.com/",
  "description": "Curated SecHub Resources SC4S pack for Proxmox VE control-plane authentication and task syslog relay rows.",
  "display_name": "Proxmox VE control-plane telemetry",
  "vendor": "proxmox",
  "product": "proxmox_ve",
  "default_index": "infraops",
  "default_source": "proxmox",
  "listener": {
    "source_id": "PROXMOX",
    "transport": "tcp",
    "port": 20074,
    "env": {
      "SC4S_LISTEN_PROXMOX_TCP_PORT": "20074",
      "SOURCE_ALL_SET_APPEND": "PROXMOX"
    }
  },
  "sourcetypes": {
    "auth": "proxmox:ve:auth",
    "service_task": "proxmox:ve:service:task",
    "task_summary": "proxmox:ve:task:summary"
  },
  "event_families": [
    {
      "id": "auth",
      "label": "Proxmox VE authentication success/failure",
      "match_engine": "pcre",
      "match": "authentication failure;|successful auth for user|SC4S_PROXMOX_TEST_AUTH_",
      "expected_sourcetype": "proxmox:ve:auth",
      "primary_id_field": "user",
      "required_fields": [
        "user",
        "action",
        "result"
      ],
      "timestamp_fields": [
        "syslog payload timestamp"
      ]
    },
    {
      "id": "service_task",
      "label": "Proxmox VE service lifecycle task rows",
      "match_engine": "pcre",
      "match": "(starting|stopping|re-starting|reloading) service .*UPID:|SC4S_PROXMOX_TEST_SERVICE_",
      "expected_sourcetype": "proxmox:ve:service:task",
      "primary_id_field": "upid",
      "required_fields": [
        "service",
        "upid",
        "user"
      ],
      "timestamp_fields": [
        "syslog payload timestamp"
      ]
    },
    {
      "id": "task_summary",
      "label": "Proxmox VE task and node lifecycle summary rows",
      "match_engine": "pcre",
      "match": "end task UPID:|all VMs and CTs stopped|SC4S_PROXMOX_TEST_TASK_END_|SC4S_PROXMOX_TEST_NODE_SUMMARY_",
      "expected_sourcetype": "proxmox:ve:task:summary",
      "primary_id_field": "upid",
      "required_fields": [
        "upid or message",
        "action",
        "result"
      ],
      "timestamp_fields": [
        "syslog payload timestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "proxmox",
    "product": "proxmox_ve",
    "vendor_product": "proxmox:proxmox_ve",
    "host": "Proxmox node hostname",
    "process": "syslog program",
    "process_id": "syslog process ID",
    "user": "realm-qualified Proxmox user where present",
    "src_ip": "remote authentication client IP for failed login rows",
    "action": "derived from Proxmox message/task context",
    "result": "authentication/task result text",
    "service": "service lifecycle task target",
    "upid": "Proxmox unique task identifier",
    "proxmox_node": "node parsed from UPID",
    "task_type": "task type token parsed from UPID",
    "task_object": "task object/VMID/service token parsed from UPID",
    "signature": "task_type or process fallback",
    "signature_id": "UPID or marker fallback",
    "marker": "synthetic fixture marker only"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-proxmox.conf",
