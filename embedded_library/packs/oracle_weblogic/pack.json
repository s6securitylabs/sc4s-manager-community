  "description": "Curated fixture-backed alpha slice for Oracle WebLogic server and access log relay records, plus catalogue-only definitions for audit provider, Node Manager, and Fusion Middleware diagnostics. Synthetic-equivalent fixtures are source-shape-derived from Oracle documentation and public ecosystem evidence; no live WebLogic, SC4S replay, HEC delivery, or Splunk read-back has passed.",
  "display_name": "Oracle WebLogic Server logs",
  "vendor": "oracle",
  "product": "weblogic",
  "default_index": "infraops",
  "default_source": "oracle_weblogic",
  "listener": {
    "source_id": "ORACLE_WEBLOGIC",
    "transport": "tcp",
    "port": 20102,
    "env": {
      "SC4S_LISTEN_ORACLE_WEBLOGIC_TCP_PORT": "20102",
      "SOURCE_ALL_SET_APPEND": "ORACLE_WEBLOGIC"
    }
  },
  "sourcetypes": {
    "oracle_weblogic_server": "oracle:weblogic:server",
    "oracle_weblogic_access": "oracle:weblogic:access",
    "oracle_weblogic_audit": "oracle:weblogic:audit",
    "oracle_weblogic_node_manager": "oracle:weblogic:nodemanager",
    "oracle_fusion_middleware": "oracle:fusion_middleware:diagnostic",
    "oracle_fusion_middleware_forms_trace": "oracle:fusion_middleware:forms_trace",
    "oracle_soa_audit": "oracle:soa:audit",
    "oracle_discoverer_server": "oracle:discoverer:server"
  },
  "event_families": [
    {
      "id": "oracle_weblogic_server",
      "label": "Server/domain log events",
      "match_engine": "pcre",
      "match": "SC4S_ORACLE_WEBLOGIC_TEST_SERVER_",
      "expected_sourcetype": "oracle:weblogic:server",
      "primary_id_field": "sechub_fixture_marker",
      "required_fields": [
        "severity",
        "subsystem",
        "message_id",
        "sechub_fixture_marker"
      ],
      "timestamp_fields": [
        "WebLogic server log timestamp"
      ]
    },
    {
      "id": "oracle_weblogic_access",
      "label": "HTTP access logs",
      "match_engine": "pcre",
      "match": "SC4S_ORACLE_WEBLOGIC_TEST_ACCESS_",
      "expected_sourcetype": "oracle:weblogic:access",
      "primary_id_field": "sechub_fixture_marker",
      "required_fields": [
        "src_ip",
        "http_method",
        "status",
        "sechub_fixture_marker"
      ],
      "timestamp_fields": [
        "WebLogic access log timestamp"
      ]
    },
    {
      "id": "oracle_weblogic_audit",
      "label": "Security/audit provider events",
      "match_engine": "pcre",
      "match": "EVIDENCE_REQUIRED_ORACLE_WEBLOGIC_ORACLE_WEBLOGIC_AUDIT_DO_NOT_ROUTE",
      "expected_sourcetype": "oracle:weblogic:audit",
      "primary_id_field": "source_shape_evidence_required",
      "required_fields": [
        "event_time",
        "source_shape_evidence"
      ],
      "timestamp_fields": [
        "source timestamp field requires validation"
      ]
    },
    {
      "id": "oracle_weblogic_node_manager",
      "label": "Node Manager lifecycle logs",
      "match_engine": "pcre",
      "match": "EVIDENCE_REQUIRED_ORACLE_WEBLOGIC_ORACLE_WEBLOGIC_NODE_MANAGER_DO_NOT_ROUTE",
      "expected_sourcetype": "oracle:weblogic:nodemanager",
      "primary_id_field": "source_shape_evidence_required",
      "required_fields": [
        "event_time",
        "source_shape_evidence"
      ],
      "timestamp_fields": [
        "source timestamp field requires validation"
