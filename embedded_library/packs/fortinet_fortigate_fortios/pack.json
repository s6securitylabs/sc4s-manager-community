  "vendor": "fortinet",
  "product": "fortigate-fortios",
  "default_index": "netfw",
  "default_source": "fortinet_fortigate_fortios",
  "listener": {
    "source_id": "FORTINET_FORTIGATE_FORTIOS",
    "transport": "tls",
    "port": 20032,
    "env": {
      "SC4S_LISTEN_FORTINET_FORTIGATE_FORTIOS_TLS_PORT": "20032",
      "SOURCE_ALL_SET_APPEND": "FORTINET_FORTIGATE_FORTIOS"
    }
  },
  "sourcetypes": {
    "traffic": "fortinet:fortigate",
    "utm": "fortinet:fortigate",
    "vpn": "fortinet:fortigate"
  },
  "event_families": [
    {
      "id": "traffic",
      "label": "FortiGate traffic events",
      "match_engine": "pcre",
      "match": "(^|[[:space:]])type=\\\"?traffic\\\"?.+(^|[[:space:]])srcip=.+(^|[[:space:]])dstip=",
      "expected_sourcetype": "fortinet:fortigate",
      "primary_id_field": "sessionid",
      "required_fields": [
        "date",
        "time",
        "logid",
        "type",
        "srcip",
        "dstip"
      ],
      "timestamp_fields": [
        "date",
        "time",
        "eventtime",
        "syslog_header"
      ]
    },
    {
      "id": "utm",
      "label": "FortiGate UTM/security events",
      "match_engine": "pcre",
      "match": "(^|[[:space:]])type=\\\"?utm\\\"?|(^|[[:space:]])(threat|virus)=",
      "expected_sourcetype": "fortinet:fortigate",
      "primary_id_field": "logid",
      "required_fields": [
        "date",
        "time",
        "logid",
        "type"
      ],
      "timestamp_fields": [
        "date",
        "time",
        "eventtime",
        "syslog_header"
      ]
    },
    {
      "id": "vpn",
      "label": "FortiGate VPN events",
      "match_engine": "pcre",
      "match": "(^|[[:space:]])subtype=\\\"?vpn\\\"?|(^|[[:space:]])tunnel(id|type)=",
      "expected_sourcetype": "fortinet:fortigate",
      "primary_id_field": "tunnelid",
      "required_fields": [
        "date",
        "time",
        "logid",
        "subtype"
      ],
      "timestamp_fields": [
        "date",
        "time",
        "eventtime",
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Fortinet",
    "product": "fortigate-fortios",
    "vendor_product": "fortinet:fortigate-fortios",
    "src": "srcip",
    "dest": "dstip",
