    ],
    "scripts": [
      "scripts/send_tls_20091.sh",
      "scripts/e2e_docker_compose.sh"
    ],
    "docs": [
      "README.md",
      "validation/preflight-2026-06-08.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tls_rfc5425",
      "label": "TLS syslog RFC5425",
      "transport": "tls",
      "recommended": true,
      "default_port": 20091,
      "notes": "Recommended where supported; PowerStore docs describe TLS certificate options for remote logging.",
      "syslog_protocol": "rfc5425",
      "framing": "octet_counted",
      "envelope": "ietf_rfc5424",
      "payload_format": "raw"
    },
    {
      "id": "udp_syslog",
      "label": "Legacy UDP syslog",
      "transport": "udp",
      "recommended": false,
      "default_port": 514,
      "notes": "Upstream SC4S docs describe legacy BSD/default port 514. Use only where TLS/TCP is unavailable.",
      "syslog_protocol": "udp_syslog",
      "framing": "datagram",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "raw"
    }
