      "id": "dell_powerstore_structured_data_smoke",
      "label": "PowerStore structured-data-marker smoke fixtures",
      "path": "test-events/dell_powerstore_test_events.txt",
      "format": "ietf",
      "wire_format": "rfc5424_with_powerstore_structured_data_marker",
      "envelope": "ietf_rfc5424",
      "serialization": "structured_data_kv",
      "event_count": 2,
      "events_per_file": "multiple",
      "event_boundary": "line",
      "record_separator": "\n",
      "one_event_per_line": true,
      "multiline": false,
      "unique_events": true,
      "marker_tokens": [
        "SC4S_DELL_POWERSTORE_TEST_REMOTE_SYSLOG_FAIL_001",
        "SC4S_DELL_POWERSTORE_TEST_REMOTE_SYSLOG_OK_002"
      ],
      "timestamp_policy": {
        "source_time_mode": "syslog_header_timezone",
        "primary_field": "rfc5424_header",
        "primary_timezone": "offset included in fixture timestamps",
        "fallback_fields": [],
        "fallback_time_mode": "receiver_time",
        "fallback_timezone": "receiver_default",
        "requires_source_timezone_when_fields_missing": [
          "rfc5424_header"
        ],
        "notes": "Exact PowerStore payload time fields require real capture."
      },
      "field_delimiting": {
        "style": "rfc5424_structured_data_key_values",
        "field_separator": "space",
        "quote_character": "double quote",
        "escape_policy": "Synthetic smoke only; replace with real PowerStore escaping after capture.",
        "notes": "One event per line."
      },
      "expected_families": [
        "powerstore"
      ]
    }
  ],
