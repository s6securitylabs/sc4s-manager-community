{
  "schema_version": "0.1",
  "id": "dell_powerstore",
  "version": "0.1.3",
  "url": "https://www.dell.com/support/kbdoc/en-us/000130110/powerstore-info-hub-product-documentation-videos",
  "description": "Curated SecHub Resources SC4S pack for Dell PowerStore remote logging. Extends upstream SC4S PowerStore routing with conservative metadata, synthetic smoke fixtures, and explicit evidence gaps.",
  "display_name": "Dell PowerStore remote logging",
  "vendor": "dell",
  "product": "powerstore",
  "default_index": "infraops",
  "default_source": "dell_powerstore",
  "listener": {
    "source_id": "DELL_POWERSTORE",
    "transport": "tls",
    "port": 20091,
    "env": {
      "SC4S_LISTEN_DELL_POWERSTORE_TLS_PORT": "20091",
      "SOURCE_ALL_SET_APPEND": "DELL_POWERSTORE"
    }
  },
  "sourcetypes": {
    "powerstore": "dell:emc:powerstore"
  },
  "event_families": [
    {
      "id": "powerstore",
      "label": "PowerStore audit and alert/event remote logging",
      "match_engine": "pcre",
      "match": "\\[PowerStore_[A-Za-z_]+@1139",
      "expected_sourcetype": "dell:emc:powerstore",
      "primary_id_field": "event_code",
      "required_fields": [
        "PowerStore structured-data marker"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Dell",
    "product": "Dell PowerStore remote logging",
    "vendor_product": "dell:powerstore",
    "event_code": "PowerStore event/alert code extracted from structured-data fixture fields.",
    "severity": "PowerStore severity token extracted from structured-data fixture fields.",
    "event_type": "PowerStore event type/source action token extracted from structured-data fixture fields.",
    "alert_raised": "PowerStore alert-raised flag extracted from structured-data fixture fields.",
    "call_home": "PowerStore call-home flag extracted from structured-data fixture fields.",
    "kb_article": "PowerStore knowledge-base article identifier extracted from structured-data fixture fields.",
    "message": "PowerStore event message extracted from structured-data fixture fields.",
    "action": "Alias of fixture-backed event_type for analyst grouping.",
    "signature": "Alias of fixture-backed message for analyst grouping.",
    "signature_id": "Alias of fixture-backed event_code for analyst grouping.",
    "marker": "Synthetic-equivalent fixture marker used for replay/read-back tests."
  },
  "artifacts": {
