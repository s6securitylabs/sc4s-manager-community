{
  "schema_version": "0.1",
  "id": "postfix_dovecot_mail",
  "version": "0.1.4",
  "url": "https://github.com/vdukhovni/postfix",
  "description": "Curated SecHub Resources SC4S pack for common Postfix MTA and Dovecot IMAP mail syslog relay records with fixture-backed delivery, rejection, cleanup, login, auth-failure, logout, and mail-log-plugin session families.",
  "display_name": "Postfix and Dovecot mail syslog relay",
  "vendor": "postfix_dovecot",
  "product": "mail_syslog",
  "default_index": "email",
  "default_source": "postfix_dovecot_mail",
  "listener": {
    "source_id": "POSTFIX_DOVECOT_MAIL",
    "transport": "tcp",
    "port": 20077,
    "env": {
      "SC4S_LISTEN_POSTFIX_DOVECOT_MAIL_TCP_PORT": "20077",
      "SOURCE_ALL_SET_APPEND": "POSTFIX_DOVECOT_MAIL"
    }
  },
  "sourcetypes": {
    "postfix_delivery": "mail:postfix:delivery",
    "postfix_reject": "mail:postfix:reject",
    "postfix_cleanup": "mail:postfix:cleanup",
    "dovecot_login": "mail:dovecot:login",
    "dovecot_session": "mail:dovecot:session",
    "dovecot_auth_failure": "mail:dovecot:auth_failure",
    "dovecot_logout": "mail:dovecot:logout"
  },
  "event_families": [
    {
      "id": "postfix_delivery",
      "label": "Postfix delivery result",
      "match_engine": "pcre",
      "match": "postfix/smtp\\[\\d+\\]: [A-F0-9]+: .*\\bstatus=sent\\b",
      "expected_sourcetype": "mail:postfix:delivery",
      "primary_id_field": "queue_id",
      "required_fields": [
        "queue_id",
        "recipient",
        "relay_host",
        "dsn",
        "vendor_raw_status"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "postfix_reject",
      "label": "Postfix postscreen/pre-queue rejection",
      "match_engine": "pcre",
      "match": "postfix/postscreen\\[\\d+\\]: NOQUEUE: reject: CONNECT from",
      "expected_sourcetype": "mail:postfix:reject",
      "primary_id_field": "queue_id",
      "required_fields": [
        "queue_id",
        "vendor_raw_action",
        "src_ip",
        "src_port",
        "reason"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "postfix_cleanup",
      "label": "Postfix cleanup message-id",
      "match_engine": "pcre",
      "match": "postfix/cleanup\\[\\d+\\]: [A-F0-9]+: message-id=<",
      "expected_sourcetype": "mail:postfix:cleanup",
      "primary_id_field": "queue_id",
      "required_fields": [
        "queue_id",
        "message_id"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "dovecot_login",
      "label": "Dovecot IMAP login",
      "match_engine": "pcre",
      "match": "dovecot: imap-login: Login: user=<.*>.*\\brip=",
      "expected_sourcetype": "mail:dovecot:login",
      "primary_id_field": "session",
      "required_fields": [
        "user",
        "auth_method",
        "rip",
        "lip",
        "session"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "dovecot_session",
      "label": "Dovecot mail-log-plugin session action",
      "match_engine": "pcre",
      "match": "dovecot: imap\\([^)]*\\): (copy|delete|expunged|save): .*\\buid=",
      "expected_sourcetype": "mail:dovecot:session",
      "primary_id_field": "message_id",
      "required_fields": [
        "user",
        "vendor_raw_action",
        "uid",
        "message_id",
        "mailbox"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "dovecot_auth_failure",
      "label": "Dovecot IMAP authentication failure",
      "match_engine": "pcre",
      "match": "dovecot: imap-login: Disconnected: auth failed.*SC4S_POSTFIX_DOVECOT_MAIL_TEST_DOVECOT_AUTH_FAILURE_",
      "expected_sourcetype": "mail:dovecot:auth_failure",
      "primary_id_field": "session",
      "required_fields": [
        "user",
        "auth_method",
        "rip",
        "lip",
        "failure_reason",
        "session"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "dovecot_logout",
      "label": "Dovecot IMAP logout counters",
      "match_engine": "pcre",
      "match": "dovecot: imap\\([^)]*\\): Logged out .*\\bin=.*\\bout=.*SC4S_POSTFIX_DOVECOT_MAIL_TEST_DOVECOT_LOGOUT_",
      "expected_sourcetype": "mail:dovecot:logout",
      "primary_id_field": "session",
      "required_fields": [
        "user",
        "session",
        "logout_in_bytes",
        "logout_out_bytes"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Postfix/Dovecot",
    "product": "mail_syslog",
    "vendor_product": "postfix_dovecot:mail_syslog",
    "syslog_timestamp": "RFC3164-style payload timestamp",
    "host": "Mail host token",
    "program": "Postfix or Dovecot program",
    "postfix_daemon": "Postfix daemon/component such as smtp, postscreen, or cleanup",
    "dovecot_program": "Dovecot component such as imap-login or imap",
    "process_id": "Program PID where present",
    "queue_id": "Postfix queue ID or NOQUEUE",
    "message_id": "Mail message identifier where present",
    "recipient": "Postfix recipient",
    "relay_host": "Postfix relay host",
    "relay_ip": "Postfix relay IP",
    "dsn": "Postfix delivery status notification token",
    "delay": "Postfix total delivery delay",
    "delays": "Postfix component delivery delays",
    "vendor_raw_status": "Raw Postfix status token such as sent",
    "vendor_raw_action": "Raw vendor action token such as reject or copy",
    "result": "Analyst result derived from raw token",
    "action": "Fixture-backed analyst action",
    "signature": "Family grouping label",
    "signature_id": "Component or daemon identifier",
    "reason": "Postfix reject reason",
    "src": "Alias for source IP",
    "src_ip": "Source IP from Postfix reject or Dovecot rip",
    "src_port": "Source port from Postfix reject",
    "dest": "Alias for destination IP/relay",
    "dest_ip": "Destination IP from Dovecot lip",
    "dest_port": "Relay destination port",
    "user": "Dovecot/login user",
    "auth_method": "Dovecot login auth method",
    "rip": "Raw Dovecot remote IP token",
    "lip": "Raw Dovecot local IP token",
    "mail_pid": "Dovecot mail process ID",
    "tls_state": "TLS marker when logged",
    "session": "Dovecot session ID",
    "uid": "Dovecot mail-log-plugin UID",
    "mailbox": "Mailbox name",
    "marker": "Synthetic fixture marker only",
    "failure_reason": "Dovecot authentication failure reason token such as auth failed",
    "logout_in_bytes": "Dovecot IMAP logout input byte counter from default imap_logout_format",
    "logout_out_bytes": "Dovecot IMAP logout output byte counter from default imap_logout_format",
    "deleted_count": "Dovecot IMAP logout deleted message counter",
    "expunged_count": "Dovecot IMAP logout expunged message counter",
    "trashed_count": "Dovecot IMAP logout trashed message counter",
    "hdr_count": "Dovecot IMAP logout fetched header count",
    "hdr_bytes": "Dovecot IMAP logout fetched header byte count",
    "body_count": "Dovecot IMAP logout fetched body count",
    "body_bytes": "Dovecot IMAP logout fetched body byte count"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-postfix_dovecot_mail.conf",
      "sc4s/env.example"
    ],
    "splunk": [
