    ],
    "docs": [
      "README.md",
      "docs/velociraptor_reduction_candidates.csv",
      "validation/preflight-2026-06-08.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tcp_syslog",
      "label": "TCP syslog / Velociraptor JSONL relay",
      "transport": "tcp",
      "recommended": true,
      "default_port": 20073,
      "notes": "Dedicated TCP listener for one JSON object per line from Velociraptor export/relay paths.",
      "syslog_protocol": "tcp_syslog",
      "framing": "line_delimited",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "json"
    }
  ],
  "recommended_transport": "tcp_syslog",
  "source_log_version": {
    "name": "Velociraptor JSON/JSONL relay rows",
    "min": "Velocidex docs/repositories through 2026-06-08",
    "max": null,
    "notes": "Grounded in public monitoring/upload/hunt/JSONL references; exact operator relay envelope must be validated locally. 2026-06-15 hardening also cites public Velociraptor artifact definitions for Windows.Network.Netstat, Windows.System.Services, and Windows.Detection.Yara.Process; 2026-06-18 hardening cites public Windows.Forensics.Prefetch artifact definitions for conservative execution-history fixture coverage."
  },
