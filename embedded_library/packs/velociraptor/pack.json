{
  "schema_version": "0.1",
  "id": "velociraptor",
  "version": "0.1.4",
  "url": "https://github.com/Velocidex/velociraptor",
  "description": "Curated SecHub Resources SC4S pack for Velociraptor JSON/JSONL monitoring, hunt-management, and artifact-result relay rows.",
  "display_name": "Velociraptor endpoint and DFIR telemetry",
  "vendor": "velocidex",
  "product": "velociraptor",
  "default_index": "oswinsec",
  "default_source": "velociraptor",
  "listener": {
    "source_id": "VELOCIRAPTOR",
    "transport": "tcp",
    "port": 20073,
    "env": {
      "SC4S_LISTEN_VELOCIRAPTOR_TCP_PORT": "20073",
      "SOURCE_ALL_SET_APPEND": "VELOCIRAPTOR"
    }
  },
  "sourcetypes": {
    "monitoring": "velociraptor:monitoring:json",
    "hunt": "velociraptor:hunt:json",
    "artifact_result": "velociraptor:artifact:result:json",
    "netstat": "velociraptor:artifact:result:json",
    "services": "velociraptor:artifact:result:json",
    "yara_process": "velociraptor:artifact:result:json",
    "prefetch": "velociraptor:artifact:result:json"
  },
  "event_families": [
    {
      "id": "monitoring",
      "label": "Velociraptor client/server monitoring relay rows",
      "match_engine": "pcre",
      "match": "\"Artifact\":\"(Generic\\.Client\\.|Elastic\\.Events\\.|LogScale\\.Events\\.)|SC4S_VELOCIRAPTOR_TEST_CLIENT_MONITORING_",
      "expected_sourcetype": "velociraptor:monitoring:json",
      "primary_id_field": "Artifact",
      "required_fields": [
        "Artifact",
        "timestamp"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "hunt",
      "label": "Velociraptor hunt lifecycle and management rows",
      "match_engine": "pcre",
      "match": "\"Artifact\":\"(Server\\.Hunts\\.List|System\\.Hunt\\.Creation|Server\\.Internal\\.HuntModification)\"|\"hunt_id\"|\"HuntId\".*SC4S_VELOCIRAPTOR_TEST_HUNT_",
      "expected_sourcetype": "velociraptor:hunt:json",
      "primary_id_field": "hunt_id",
      "required_fields": [
        "Artifact",
        "hunt_id or HuntId"
      ],
      "timestamp_fields": [
        "timestamp",
        "Created"
      ]
    },
    {
      "id": "artifact_result",
      "label": "Velociraptor artifact result pass-through rows",
      "match_engine": "pcre",
      "match": "\"ArtifactRow\"|\"FlowId\"|SC4S_VELOCIRAPTOR_TEST_ARTIFACT_RESULT_",
      "expected_sourcetype": "velociraptor:artifact:result:json",
      "primary_id_field": "FlowId",
      "required_fields": [
        "Artifact",
        "ClientId or HuntId",
        "ArtifactRow or FlowId"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "netstat",
      "label": "Velociraptor Windows.Network.Netstat artifact-result rows",
      "match_engine": "pcre",
      "match": "\"Artifact\":\"Windows\\.Network\\.Netstat\"|SC4S_VELOCIRAPTOR_TEST_NETSTAT_",
      "expected_sourcetype": "velociraptor:artifact:result:json",
      "primary_id_field": "Pid",
      "required_fields": [
        "Artifact",
        "Pid",
        "Laddr.IP",
        "Raddr.IP"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "services",
      "label": "Velociraptor Windows.System.Services artifact-result rows",
      "match_engine": "pcre",
      "match": "\"Artifact\":\"Windows\\.System\\.Services\"|SC4S_VELOCIRAPTOR_TEST_SERVICE_",
      "expected_sourcetype": "velociraptor:artifact:result:json",
      "primary_id_field": "Name",
      "required_fields": [
        "Artifact",
        "Name",
        "State",
        "PathName"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "yara_process",
      "label": "Velociraptor Windows.Detection.Yara.Process artifact-result rows",
      "match_engine": "pcre",
      "match": "\"Artifact\":\"Windows\\.Detection\\.Yara\\.Process\"|SC4S_VELOCIRAPTOR_TEST_YARA_PROCESS_",
      "expected_sourcetype": "velociraptor:artifact:result:json",
      "primary_id_field": "Rule",
      "required_fields": [
        "Artifact",
        "ProcessName",
        "Pid",
        "Rule"
      ],
      "timestamp_fields": [
        "timestamp"
      ]
    },
    {
      "id": "prefetch",
      "label": "Velociraptor Windows.Forensics.Prefetch execution-history rows",
      "match_engine": "pcre",
      "match": "\"Artifact\":\"Windows\\.Forensics\\.Prefetch\"|SC4S_VELOCIRAPTOR_TEST_PREFETCH_",
      "expected_sourcetype": "velociraptor:artifact:result:json",
      "primary_id_field": "Executable",
      "required_fields": [
        "Artifact",
        "Executable",
        "Hash",
        "RunCount",
        "PrefetchFileName"
      ],
      "timestamp_fields": [
        "timestamp",
        "ExecutionTime",
        "LastRunTimes"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "velocidex",
    "product": "velociraptor",
    "vendor_product": "velocidex:velociraptor",
    "artifact": "Velociraptor Artifact field",
    "client_id": "Velociraptor ClientId",
    "host": "Hostname relay field",
    "hunt_id": "hunt_id/HuntId",
    "flow_id": "FlowId",
    "user": "User or Creator where present",
    "timestamp": "relay timestamp",
    "action": "derived from sourcetype/artifact context",
    "signature": "artifact name",
    "signature_id": "hunt/flow/client identifier fallback",
    "marker": "synthetic fixture marker only",
    "pid": "Process identifier in concrete artifact-result rows",
    "process_name": "ProcessName or Name where artifact rows provide process/service context",
    "process_path": "ExePath/PathName process or service executable path",
    "command_line": "CommandLine where present",
    "rule": "YARA Rule or artifact rule context",
    "src_ip": "Laddr.IP local socket address",
    "src_port": "Laddr.Port local socket port",
    "dest_ip": "Raddr.IP remote socket address",
    "dest_port": "Raddr.Port remote socket port",
    "network_status": "Netstat Status",
    "service_state": "Windows service State",
    "service_start_mode": "Windows service StartMode",
    "executable": "Executable from Windows.Forensics.Prefetch artifact rows",
    "executable_path": "ExecutablePath or ExecutableDosPath from Windows.Forensics.Prefetch artifact rows",
    "prefetch_hash": "Prefetch parser Hash value for execution-history row correlation",
    "run_count": "RunCount from Windows.Forensics.Prefetch artifact rows",
    "prefetch_file": "PrefetchFileName source artifact file context",
    "execution_time": "ExecutionTime / LastRunTimes context from Windows.Forensics.Prefetch artifact rows"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-velociraptor.conf",
      "sc4s/env.example"
    ],
    "splunk": [
      "splunk/default/props.conf",
