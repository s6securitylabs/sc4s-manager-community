      "validation/preflight-2026-06-08.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tcp_syslog",
      "label": "TCP syslog",
      "transport": "tcp",
      "recommended": true,
      "default_port": 20046,
      "notes": "Dedicated TCP listener for ZIA NSS JSON feed onboarding.",
      "syslog_protocol": "tcp_syslog",
      "framing": "line_delimited",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "json"
