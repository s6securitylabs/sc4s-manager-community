        "source_time_mode": "field_with_timezone",
        "primary_field": "event.time/event.datetime",
        "primary_timezone": "web fixture has event.tz=GMT; firewall example timezone is feed/deployment dependent",
        "fallback_fields": [],
        "fallback_time_mode": "receiver_time",
        "fallback_timezone": "receiver_default",
        "requires_source_timezone_when_fields_missing": [
          "event.tz",
          "feed timezone configuration"
        ],
        "notes": "Production validation must confirm ZIA NSS template timezone handling."
      },
      "field_delimiting": {
        "style": "json",
        "field_separator": "JSON object per line",
        "quote_character": "double quote",
        "escape_policy": "JSON escaping; fixtures use documentation/example identities",
        "notes": "Fixtures are reduced synthetic-equivalent records from public Elastic package sample shapes."
      },
      "expected_families": [
        "zia_web",
        "zia_firewall"
      ]
    }
