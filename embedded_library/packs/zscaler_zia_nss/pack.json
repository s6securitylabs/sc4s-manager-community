{
  "schema_version": "0.1",
  "id": "zscaler_zia_nss",
  "version": "0.1.3",
  "url": "https://github.com/elastic/integrations/tree/main/packages/zscaler_zia",
  "description": "Conservative SecHub Resources SC4S pack for Zscaler Internet Access NSS JSON web and firewall feeds, grounded in upstream SC4S Zscaler inventory and public Elastic zscaler_zia sample schemas without stating lab validation.",
  "display_name": "Zscaler Internet Access NSS",
  "vendor": "zscaler",
  "product": "zia",
  "default_index": "netproxy",
  "default_source": "zscaler_zia_nss",
  "listener": {
    "source_id": "ZSCALER_ZIA_NSS",
    "transport": "tcp",
    "port": 20046,
    "env": {
      "SC4S_LISTEN_ZSCALER_ZIA_NSS_TCP_PORT": "20046",
      "SOURCE_ALL_SET_APPEND": "ZSCALER_ZIA_NSS"
    }
  },
  "sourcetypes": {
    "zia_web": "zscaler:zia:web",
    "zia_firewall": "zscaler:zia:firewall"
  },
  "event_families": [
    {
      "id": "zia_web",
      "label": "ZIA NSS web JSON events",
      "match_engine": "pcre",
      "match": "\"sourcetype\"\\s*:\\s*\"zscalernss-web\"",
      "expected_sourcetype": "zscaler:zia:web",
      "primary_id_field": "recordid",
      "required_fields": [
        "sourcetype",
        "event.time",
        "event.action"
      ],
      "timestamp_fields": [
        "event.time",
        "event.tz"
      ]
    },
    {
      "id": "zia_firewall",
      "label": "ZIA NSS firewall JSON events",
      "match_engine": "pcre",
      "match": "\"sourcetype\"\\s*:\\s*\"zscalernss-fw\"",
      "expected_sourcetype": "zscaler:zia:firewall",
      "primary_id_field": "recordid",
      "required_fields": [
        "sourcetype",
        "event.datetime",
        "event.action"
      ],
      "timestamp_fields": [
        "event.datetime"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Zscaler",
    "product": "ZIA",
    "vendor_product": "zscaler:zia",
    "src": "event.cltip or event.csip",
    "dest": "event.serverip or event.cdip",
    "dest_port": "event.cdport",
    "transport": "event.proto",
    "user": "event.login or event.user",
    "action": "event.action",
    "severity": "event.threatseverity",
    "app": "event.appname or event.nwapp",
    "src_ip": "event.cltip or event.csip",
    "src_port": "event.cltsourceport or event.csport",
    "dest_ip": "event.serverip or event.cdip",
    "rule": "event.rulelabel",
    "url_host": "event.host"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-zscaler_zia_nss.conf",
      "sc4s/env.example"
    ],
    "splunk": [
      "splunk/default/props.conf",
      "splunk/default/transforms.conf",
      "splunk/default/eventtypes.conf",
      "splunk/default/tags.conf",
