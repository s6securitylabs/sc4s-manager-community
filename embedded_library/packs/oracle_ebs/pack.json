{
  "schema_version": "0.1",
  "id": "oracle_ebs",
  "version": "0.2.4",
  "url": "https://www.oracle.com/security-alerts/cspumay2026verbose.html",
  "description": "Curated SecHub Resources SC4S/Splunk pack for Oracle E-Business Suite security and audit monitoring through a site-owned normalized JSON relay. Covers EBS sign-on audit, AuditTrail sensitive changes, FND/security errors, concurrent request failures, workflow/mailer errors, admin/security configuration changes, OHS/WebLogic/Forms/OAF app-tier events, and May 2026 Oracle Payments File Transmission advisory-focus context plus broader EBS module monitoring. Official Oracle docs/eTRM support the generic source-family mapping, while native EBS table/log source shapes and live replay/read-back remain blocked until source-backed samples are provided.",
  "display_name": "Oracle E-Business Suite security and audit logs",
  "vendor": "oracle",
  "product": "e_business_suite",
  "default_index": "main",
  "default_source": "oracle_ebs",
  "listener": {
    "source_id": "ORACLE_EBS",
    "transport": "tcp",
    "port": 20104,
    "env": {
      "SC4S_LISTEN_ORACLE_EBS_TCP_PORT": "20104",
      "SOURCE_ALL_SET_APPEND": "ORACLE_EBS"
    }
  },
  "sourcetypes": {
    "ebs_signon_success": "oracle:ebs:security:json",
    "ebs_signon_failure": "oracle:ebs:security:json",
    "ebs_audittrail_sensitive_change": "oracle:ebs:security:json",
