    "event_time": "UTC timestamp emitted by the normalized relay.",
    "event_family": "EBS family used by parser/dashboard routing.",
    "user": "EBS user, APPS account, or application actor preserved from source-backed relay.",
    "responsibility": "EBS responsibility when available.",
    "application": "EBS application/module name.",
    "src_ip": "Client/source IP when available.",
    "action": "Raw collector/source action token.",
    "status": "Raw collector/source status/result.",
    "severity": "Collector-normalized severity from source context; raw severity preserved where available.",
    "cve": "Advisory reference when the event is explicitly tagged for May/June 2026 monitoring.",
    "message": "Source or collector summary with raw event retained in _raw.",
    "config_scope": "Collector-normalized administrative/security configuration scope when source-backed context is available.",
    "request_status": "Concurrent request status/result when emitted by the relay.",
    "mailer_component": "Workflow or Notification Mailer component when emitted by the relay."
