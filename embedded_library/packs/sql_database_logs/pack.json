{
  "schema_version": "0.1",
  "id": "sql_database_logs",
  "version": "0.1.5",
  "url": "https://www.postgresql.org/docs/current/runtime-config-logging.html",
  "description": "Curated SecHub Resources SC4S pack for PostgreSQL, MySQL, and MariaDB native text-log relay lines, including fixture-backed PostgreSQL statement-duration metadata and MariaDB error-log auth failure coverage.",
  "display_name": "SQL database logs",
  "vendor": "postgresql_mysql_mariadb",
  "product": "database_logs",
  "default_index": "infraops",
  "default_source": "sql_database_logs",
  "listener": {
    "source_id": "SQL_DATABASE_LOGS",
    "transport": "tcp",
    "port": 20079,
    "env": {
      "SC4S_LISTEN_SQL_DATABASE_LOGS_TCP_PORT": "20079",
      "SOURCE_ALL_SET_APPEND": "SQL_DATABASE_LOGS"
    }
  },
  "sourcetypes": {
    "postgresql_text": "postgresql:server:log",
    "mysql_error": "mysql:error:log",
    "mysql_slow": "mysql:slowquery:log",
    "mariadb_general": "mariadb:general:log",
    "postgresql_statement_duration": "postgresql:server:log",
    "mariadb_error": "mariadb:error:log"
  },
  "event_families": [
    {
      "id": "postgresql_text",
      "label": "PostgreSQL text server log",
      "match_engine": "pcre",
      "match": "SC4S_SQL_DATABASE_LOGS_TEST_POSTGRES_",
      "expected_sourcetype": "postgresql:server:log",
      "primary_id_field": "marker",
      "required_fields": [
        "db_user",
        "database",
        "severity"
      ],
      "timestamp_fields": [
        "postgresql log prefix timestamp"
      ]
    },
    {
      "id": "postgresql_statement_duration",
      "label": "PostgreSQL statement duration text log",
      "match_engine": "pcre",
      "match": "SC4S_SQL_DATABASE_LOGS_TEST_POSTGRES_DURATION_",
      "expected_sourcetype": "postgresql:server:log",
      "primary_id_field": "marker",
      "required_fields": [
        "db_user",
        "database",
        "query_time",
        "db_statement"
      ],
      "timestamp_fields": [
        "postgresql log prefix timestamp"
      ]
    },
    {
      "id": "mysql_error",
      "label": "MySQL/MariaDB error log",
      "match_engine": "pcre",
      "match": "SC4S_SQL_DATABASE_LOGS_TEST_MYSQL_ERROR_",
      "expected_sourcetype": "mysql:error:log",
      "primary_id_field": "marker",
      "required_fields": [
        "severity",
        "db_message"
      ],
      "timestamp_fields": [
        "mysql error timestamp"
      ]
    },
    {
      "id": "mariadb_error",
      "label": "MariaDB error log",
      "match_engine": "pcre",
      "match": "SC4S_SQL_DATABASE_LOGS_TEST_MARIADB_ERROR_",
      "expected_sourcetype": "mariadb:error:log",
      "primary_id_field": "marker",
      "required_fields": [
        "severity",
        "db_message"
      ],
      "timestamp_fields": [
        "mariadb error timestamp"
      ]
    },
    {
      "id": "mysql_slow",
      "label": "MySQL/MariaDB slow-query metadata",
      "match_engine": "pcre",
      "match": "SC4S_SQL_DATABASE_LOGS_TEST_MYSQL_SLOW_",
      "expected_sourcetype": "mysql:slowquery:log",
      "primary_id_field": "marker",
      "required_fields": [
        "db_user",
        "query_time",
        "rows_examined"
      ],
      "timestamp_fields": [
        "slow-query # Time field"
      ]
    },
    {
      "id": "mariadb_general",
      "label": "MariaDB general-query log",
      "match_engine": "pcre",
      "match": "SC4S_SQL_DATABASE_LOGS_TEST_MARIADB_GENERAL_",
      "expected_sourcetype": "mariadb:general:log",
      "primary_id_field": "marker",
      "required_fields": [
        "db_command",
        "db_message"
      ],
      "timestamp_fields": [
        "mariadb general log timestamp"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "postgresql, mysql, or mariadb depending on routed sourcetype",
    "product": "database server product for the routed sourcetype",
    "vendor_product": "vendor/product composite",
    "db_time": "source log timestamp token",
    "db_user": "database user/principal where present",
    "user": "alias of db_user where present",
    "src_user": "alias of db_user for auth/accounting context",
    "database": "database/schema name where present",
    "db_host": "database log host/client token where present",
    "src_ip": "client IP where present",
    "src": "alias of src_ip where present",
    "process_id": "PostgreSQL process ID",
    "thread_id": "MySQL/MariaDB thread or connection identifier",
    "severity": "source severity token",
    "error_code": "MySQL error code token where present",
    "component": "MySQL component token where present",
    "db_command": "MariaDB general-query command token",
    "query_time": "slow-query execution time in seconds",
    "lock_time": "slow-query lock time in seconds",
    "rows_sent": "slow-query rows sent count",
    "rows_examined": "slow-query rows examined count",
    "db_message": "sanitized source message/argument context",
    "action": "derived analyst action from command/severity/message",
    "signature": "severity, error code, command, or slow-query grouping",
    "signature_id": "fixture marker for synthetic tests",
    "marker": "synthetic fixture marker only",
    "db_statement": "sanitized SQL statement text where statement logging is enabled",
    "query_duration_ms": "PostgreSQL statement duration in milliseconds where present"
  },
