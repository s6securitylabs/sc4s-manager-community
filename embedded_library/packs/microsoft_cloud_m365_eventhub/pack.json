{
  "schema_version": "0.1",
  "id": "microsoft_cloud_m365_eventhub",
  "version": "0.1.6",
  "url": "https://learn.microsoft.com/en-us/office/office-365-management-api/office-365-management-activity-api-schema",
  "description": "Broad Microsoft Cloud/M365 JSON intake pack for Cribl or Event Hub pipelines carrying Office 365 Management Activity, Entra, Azure resource/activity, Purview audit/DLP, Intune audit, Defender, Exchange, SharePoint, and related source types.",
  "display_name": "Microsoft Cloud / M365 Event Hub + Cribl",
  "vendor": "microsoft",
  "product": "microsoft_cloud",
  "default_index": "main",
  "default_source": "microsoft_cloud_m365_eventhub",
  "listener": {
    "source_id": "MICROSOFT_CLOUD_M365_EVENTHUB",
    "transport": "tcp",
    "port": 20061,
    "env": {
      "SC4S_LISTEN_MICROSOFT_CLOUD_M365_EVENTHUB_TCP_PORT": "20061",
      "SOURCE_ALL_SET_APPEND": "MICROSOFT_CLOUD_M365_EVENTHUB"
    }
  },
  "sourcetypes": {
    "o365_management": "microsoft:365:management",
    "exchange": "microsoft:365:exchange:audit",
    "sharepoint": "microsoft:365:sharepoint:audit",
    "entra_audit": "microsoft:entra:audit",
    "entra_signin": "microsoft:entra:signin",
    "azure_resource": "microsoft:azure:resource",
    "purview_dlp": "microsoft:purview:dlp",
    "defender": "microsoft:defender:advancedhunting",
    "entra_identityprotection": "microsoft:entra:identityprotection",
    "azure_activity": "microsoft:azure:activity",
    "purview_audit": "microsoft:purview:audit",
    "intune_audit": "microsoft:intune:audit"
  },
  "event_families": [
    {
      "id": "o365_management",
      "label": "Microsoft 365 Management Activity API generic audit",
      "match_engine": "pcre",
      "match": "\"CreationTime\".*\"Workload\"",
      "expected_sourcetype": "microsoft:365:management",
      "primary_id_field": "Id",
      "required_fields": [
        "CreationTime",
        "Workload",
        "Operation"
      ],
      "timestamp_fields": [
        "CreationTime"
      ]
    },
    {
      "id": "exchange",
      "label": "Exchange Online audit",
      "match_engine": "pcre",
      "match": "\"Workload\"\\s*:\\s*\"Exchange\"",
      "expected_sourcetype": "microsoft:365:exchange:audit",
      "primary_id_field": "Id",
      "required_fields": [
        "CreationTime",
        "Workload",
        "Operation"
      ],
      "timestamp_fields": [
        "CreationTime"
      ]
    },
    {
      "id": "sharepoint",
      "label": "SharePoint/OneDrive audit",
      "match_engine": "pcre",
      "match": "\"Workload\"\\s*:\\s*\"(?:SharePoint|OneDrive)\"",
      "expected_sourcetype": "microsoft:365:sharepoint:audit",
      "primary_id_field": "Id",
      "required_fields": [
        "CreationTime",
        "Workload",
        "Operation"
      ],
      "timestamp_fields": [
        "CreationTime"
      ]
    },
    {
      "id": "entra_audit",
      "label": "Microsoft Entra audit logs",
      "match_engine": "pcre",
      "match": "\"category\"\\s*:\\s*\"AuditLogs\"",
      "expected_sourcetype": "microsoft:entra:audit",
      "primary_id_field": "id",
      "required_fields": [
        "time",
        "category",
        "operationName"
      ],
      "timestamp_fields": [
        "time"
      ]
    },
    {
      "id": "entra_signin",
      "label": "Microsoft Entra sign-in logs",
      "match_engine": "pcre",
      "match": "\"category\"\\s*:\\s*\"SignInLogs\"",
      "expected_sourcetype": "microsoft:entra:signin",
      "primary_id_field": "id",
      "required_fields": [
        "time",
        "category",
        "userPrincipalName"
      ],
      "timestamp_fields": [
        "time"
      ]
    },
    {
      "id": "entra_identityprotection",
      "label": "Microsoft Entra Identity Protection risky users/detections",
      "match_engine": "pcre",
      "match": "(?:\"category\"\\s*:\\s*\"(?:RiskyUsers|RiskDetections)\"|\"riskState\"\\s*:|\"sourcetype\"\\s*:\\s*\"azure:identityprotection\")",
      "expected_sourcetype": "microsoft:entra:identityprotection",
      "primary_id_field": "userPrincipalName",
      "required_fields": [
        "time",
        "category",
        "userPrincipalName",
        "riskState"
      ],
      "timestamp_fields": [
        "time",
        "detectedDateTime"
      ]
    },
    {
      "id": "azure_resource",
      "label": "Azure Monitor resource logs",
      "match_engine": "pcre",
      "match": "\"resourceId\"\\s*:",
      "expected_sourcetype": "microsoft:azure:resource",
      "primary_id_field": "correlationId",
      "required_fields": [
        "time",
        "resourceId",
        "category",
        "operationName"
      ],
      "timestamp_fields": [
        "time",
        "TimeGenerated"
      ]
    },
    {
      "id": "azure_activity",
      "label": "Azure Activity Log administrative events",
      "match_engine": "pcre",
      "match": "(?:\"category\"\\s*:\\s*\"Administrative\"|\"sourcetype\"\\s*:\\s*\"azure:activity\")",
      "expected_sourcetype": "microsoft:azure:activity",
      "primary_id_field": "correlationId",
      "required_fields": [
        "time",
        "category",
        "resourceId",
        "caller"
      ],
      "timestamp_fields": [
        "time",
        "submissionTimestamp"
      ]
    },
    {
      "id": "purview_dlp",
      "label": "Microsoft Purview / DLP audit records",
      "match_engine": "pcre",
      "match": "(?:\"Workload\"\\s*:\\s*\"DataLossPrevention\"|DlpRuleMatch|\"sourcetype\"\\s*:\\s*\"purview:dlp\")",
      "expected_sourcetype": "microsoft:purview:dlp",
      "primary_id_field": "Id",
      "required_fields": [
        "CreationTime",
        "Operation"
      ],
      "timestamp_fields": [
        "CreationTime"
      ]
    },
    {
      "id": "purview_audit",
      "label": "Microsoft Purview audit and sensitivity labels",
      "match_engine": "pcre",
      "match": "(?:\"Workload\"\\s*:\\s*\"SecurityComplianceCenter\"|SensitivityLabel|\"sourcetype\"\\s*:\\s*\"purview:audit\")",
      "expected_sourcetype": "microsoft:purview:audit",
      "primary_id_field": "Id",
      "required_fields": [
        "CreationTime",
        "Workload",
        "Operation"
      ],
      "timestamp_fields": [
        "CreationTime"
      ]
    },
    {
      "id": "defender",
      "label": "Microsoft Defender advanced hunting/security records",
      "match_engine": "pcre",
      "match": "(?:AdvancedHunting|DeviceProcessEvents|\"sourcetype\"\\s*:\\s*\"m365:defender)",
      "expected_sourcetype": "microsoft:defender:advancedhunting",
      "primary_id_field": "ReportId",
      "required_fields": [
        "time",
        "category"
      ],
      "timestamp_fields": [
        "time",
        "Timestamp"
      ]
    },
    {
      "id": "intune_audit",
      "label": "Microsoft Intune audit and device compliance administration",
      "match_engine": "pcre",
      "match": "(?:\"category\"\\s*:\\s*\"IntuneAuditLogs\"|\"sourcetype\"\\s*:\\s*\"intune:audit\"|DeviceCompliancePolicy)",
      "expected_sourcetype": "microsoft:intune:audit",
      "primary_id_field": "id",
      "required_fields": [
        "time",
        "category",
        "operationName"
      ],
      "timestamp_fields": [
        "time",
        "activityDateTime"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Microsoft",
    "product": "Service family derived by routed sourcetype",
    "vendor_product": "microsoft:cloud",
    "ms_source_sourcetype": "Original Cribl/source sourcetype when present",
    "operation": "Operation, operationName, nested operationName.value, or activity",
    "action": "Operation, operationName, nested operationName.value, or activity",
    "user": "UserId, userPrincipalName, identity, nested actor.userPrincipalName/identity.statement.upn, InitiatingProcessAccountUpn, or caller",
    "src": "ClientIP, ipAddress, or callerIpAddress",
    "src_ip": "ClientIP, ipAddress, or callerIpAddress",
    "result": "ResultStatus/result/resultType/resultDescription/activityResult/riskState/status.value",
    "object": "ObjectId or resourceId",
    "app": "Application/AppName/appDisplayName",
    "marker": "Synthetic fixture marker only",
    "risk": "riskLevel/riskState/riskDetail/riskLevelAggregated for Entra risk/sign-in records",
    "label": "SensitivityLabelName/SensitivityLabelId for Purview audit examples",
    "resource_provider": "resourceProviderName.value/provider parsed from resourceId in Azure panels",
    "intune_target": "targetResources displayName/type from Intune audit examples",
    "risk_level": "riskLevel or riskLevelAggregated for Entra sign-in/Identity Protection records",
    "risk_state": "riskState for Identity Protection records",
    "risk_detail": "riskDetail for Identity Protection records",
    "activity_time": "activityDateTime where provided by Intune or other Microsoft audit feeds",
    "detected_time": "detectedDateTime where provided by Identity Protection feeds",
    "resource_group": "resourceGroupName for Azure Activity records",
    "status": "Nested status.value or service-specific status/result token exposed for Azure Activity and related read-back checks",
    "sensitivity_label": "SensitivityLabelName for Purview label/audit rows"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-microsoft_cloud_m365_eventhub.conf",
      "sc4s/env.example"
    ],
    "splunk": [
      "splunk/default/props.conf",
      "splunk/default/transforms.conf",
      "splunk/default/eventtypes.conf",
      "splunk/default/tags.conf",
