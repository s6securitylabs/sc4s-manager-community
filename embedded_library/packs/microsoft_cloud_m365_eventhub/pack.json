    ],
    "test_events": [
      "test-events/microsoft_cloud_m365_eventhub_test_events.txt"
    ],
    "scripts": [
      "scripts/send_tcp_20061.sh",
      "scripts/e2e_docker_compose.sh"
    ],
    "docs": [
      "README.md",
      "docs/microsoft_cloud_reduction_candidates.csv",
