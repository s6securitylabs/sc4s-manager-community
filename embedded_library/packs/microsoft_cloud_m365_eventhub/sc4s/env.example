# Microsoft Cloud / M365 Event Hub or Cribl relay profile example.
# Use a dedicated listener/source tag so broad Microsoft JSON does not steal unrelated logs.
SC4S_LISTEN_MICROSOFT_CLOUD_M365_EVENTHUB_TCP_PORT=20061
SOURCE_ALL_SET_APPEND=MICROSOFT_CLOUD_M365_EVENTHUB
# If using Cribl, send newline-delimited JSON or syslog-wrapped JSON to the dedicated listener.
