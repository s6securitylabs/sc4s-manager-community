      "default_port": 20030,
      "notes": "Recommended production transport for pfSense filterlog into SC4S.",
      "syslog_protocol": "rfc5425",
      "framing": "octet_counted",
      "envelope": "ietf_rfc5424",
      "payload_format": "csv"
