{
  "schema_version": "0.1",
  "id": "pfsense_filterlog",
  "version": "0.1.4",
  "url": "https://docs.netgate.com/pfsense/en/latest/monitoring/logs/raw-filter-format.html",
  "description": "Curated SecHub Resources SC4S pack for pfSense filterlog firewall records. Parses documented CSV common/transport fields, routes TCP/UDP/ICMP families, ships Splunk props/eventtypes/tags, and includes synthetic-equivalent fixtures with explicit validation gaps.",
  "display_name": "pfSense Filterlog",
  "vendor": "pfsense",
  "product": "filterlog",
  "default_index": "netfw",
  "default_source": "pfsense_filterlog",
  "listener": {
    "source_id": "PFSENSE_FILTERLOG",
    "transport": "tls",
    "port": 20030,
    "env": {
      "SC4S_LISTEN_PFSENSE_FILTERLOG_TLS_PORT": "20030",
      "SOURCE_ALL_SET_APPEND": "PFSENSE_FILTERLOG"
    }
  },
  "sourcetypes": {
    "filterlog_tcp": "pfsense:filterlog:tcp",
    "filterlog_udp": "pfsense:filterlog:udp",
    "filterlog_icmp": "pfsense:filterlog:icmp"
  },
  "event_families": [
    {
      "id": "filterlog_tcp",
      "label": "pfSense filterlog TCP firewall events",
      "match_engine": "pcre",
      "match": "^[0-9]+,[0-9]*,[^,]*,[0-9]+,[^,]+,match,(pass|block),(in|out),[46],.*,(6|tcp),",
      "expected_sourcetype": "pfsense:filterlog:tcp",
      "primary_id_field": "tracker",
      "required_fields": [
        "tracker",
        "interface",
        "action",
        "direction",
        "protocol",
        "src_ip",
        "dest_ip"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "filterlog_udp",
      "label": "pfSense filterlog UDP firewall events",
      "match_engine": "pcre",
      "match": "^[0-9]+,[0-9]*,[^,]*,[0-9]+,[^,]+,match,(pass|block),(in|out),[46],.*,(17|udp),",
      "expected_sourcetype": "pfsense:filterlog:udp",
      "primary_id_field": "tracker",
      "required_fields": [
        "tracker",
        "interface",
        "action",
        "direction",
        "protocol",
        "src_ip",
        "dest_ip"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "filterlog_icmp",
      "label": "pfSense filterlog ICMP firewall events",
      "match_engine": "pcre",
      "match": "^[0-9]+,[0-9]*,[^,]*,[0-9]+,[^,]+,match,(pass|block),(in|out),[46],.*,(1|58|icmp),",
      "expected_sourcetype": "pfsense:filterlog:icmp",
      "primary_id_field": "tracker",
      "required_fields": [
        "tracker",
        "interface",
        "action",
        "direction",
        "protocol",
        "src_ip",
        "dest_ip"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "pfSense",
    "product": "filterlog",
    "vendor_product": "pfsense:filterlog",
    "action": "action",
    "signature_id": "tracker",
    "signature": "reason",
    "src": "src_ip",
    "dest": "dest_ip",
    "dest_port": "dest_port",
    "transport": "protocol",
    "direction": "direction"
  },
  "artifacts": {
