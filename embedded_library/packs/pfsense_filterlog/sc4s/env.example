# pfSense filterlog dedicated TLS listener.
# SOURCE_ALL_SET only enables/generates the source/listener and .source.s_PFSENSE_FILTERLOG tag.
# It is not index routing.
SC4S_LISTEN_PFSENSE_FILTERLOG_TLS_PORT=20030
# Append PFSENSE_FILTERLOG to existing SOURCE_ALL_SET, or use this value when starting from default only:
SOURCE_ALL_SET=DEFAULT,PFSENSE_FILTERLOG
