{
  "schema_version": "0.1",
  "id": "container_runtime_systemd_logs",
  "version": "0.1.3",
  "url": "https://docs.docker.com/engine/logging/drivers/json-file/",
  "description": "Curated SecHub Resources SC4S pack for Docker/container runtime logs and systemd/journald service relay records.",
  "display_name": "Container runtime and systemd service logs",
  "vendor": "container_runtime",
  "product": "docker_cri_systemd_logs",
  "default_index": "osnix",
  "default_source": "container_runtime_systemd_logs",
  "listener": {
    "source_id": "CONTAINER_RUNTIME_SYSTEMD",
    "transport": "tcp",
    "port": 20080,
    "env": {
      "SC4S_LISTEN_CONTAINER_RUNTIME_SYSTEMD_TCP_PORT": "20080",
      "SOURCE_ALL_SET_APPEND": "CONTAINER_RUNTIME_SYSTEMD"
    }
  },
  "sourcetypes": {
    "docker_json_stdout": "docker:container:json_file",
    "docker_json_stderr": "docker:container:json_file",
    "cri_stdout": "container:cri:runtime",
    "cri_stderr": "container:cri:runtime",
    "cri_partial": "container:cri:runtime",
    "docker_engine_event": "docker:engine:event",
    "journald_docker_service": "systemd:journald:service",
    "journald_service": "systemd:journald:service",
    "docker_journald_container": "docker:journald:container"
  },
  "event_families": [
    {
      "id": "docker_json_stdout",
      "label": "Docker json-file stdout record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_DOCKER_JSON_STDOUT_",
      "expected_sourcetype": "docker:container:json_file",
      "primary_id_field": "marker_family",
      "required_fields": [
        "time",
        "stream",
        "log"
      ],
      "timestamp_fields": [
        "time"
      ]
    },
    {
      "id": "docker_json_stderr",
      "label": "Docker json-file stderr record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_DOCKER_JSON_STDERR_",
      "expected_sourcetype": "docker:container:json_file",
      "primary_id_field": "marker_family",
      "required_fields": [
        "time",
        "stream",
        "log"
      ],
      "timestamp_fields": [
        "time"
      ]
    },
    {
      "id": "cri_stdout",
      "label": "CRI stdout full-line record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_CRI_STDOUT_",
      "expected_sourcetype": "container:cri:runtime",
      "primary_id_field": "marker_family",
      "required_fields": [
        "cri_time",
        "stream",
        "cri_flag",
        "message"
      ],
      "timestamp_fields": [
        "cri_time"
      ]
    },
    {
      "id": "cri_stderr",
      "label": "CRI stderr full-line record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_CRI_STDERR_",
      "expected_sourcetype": "container:cri:runtime",
      "primary_id_field": "marker_family",
      "required_fields": [
        "cri_time",
        "stream",
        "cri_flag",
        "message"
      ],
      "timestamp_fields": [
        "cri_time"
      ]
    },
    {
      "id": "cri_partial",
      "label": "CRI partial-line record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_CRI_PARTIAL_",
      "expected_sourcetype": "container:cri:runtime",
      "primary_id_field": "marker_family",
      "required_fields": [
        "cri_time",
        "stream",
        "cri_flag",
        "message"
      ],
      "timestamp_fields": [
        "cri_time"
      ]
    },
    {
      "id": "docker_engine_event",
      "label": "Docker Engine lifecycle event JSON",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_DOCKER_EVENT_",
      "expected_sourcetype": "docker:engine:event",
      "primary_id_field": "Actor.ID",
      "required_fields": [
        "Type",
        "Action",
        "Actor.ID"
      ],
      "timestamp_fields": [
        "timeNano",
        "time"
      ]
    },
    {
      "id": "journald_docker_service",
      "label": "Docker daemon systemd/journald service record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_JOURNALD_DOCKER_",
      "expected_sourcetype": "systemd:journald:service",
      "primary_id_field": "_SYSTEMD_UNIT",
      "required_fields": [
        "MESSAGE",
        "_SYSTEMD_UNIT",
        "SYSLOG_IDENTIFIER"
      ],
      "timestamp_fields": [
        "__REALTIME_TIMESTAMP"
      ]
    },
    {
      "id": "journald_service",
      "label": "Generic systemd/journald service stdout record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_JOURNALD_SERVICE_",
      "expected_sourcetype": "systemd:journald:service",
      "primary_id_field": "_SYSTEMD_UNIT",
      "required_fields": [
        "MESSAGE",
        "_SYSTEMD_UNIT",
        "SYSLOG_IDENTIFIER"
      ],
      "timestamp_fields": [
        "__REALTIME_TIMESTAMP"
      ]
    },
    {
      "id": "docker_journald_container",
      "label": "Docker journald-driver container metadata record",
      "match_engine": "pcre",
      "match": "SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_DOCKER_JOURNALD_CONTAINER_",
      "expected_sourcetype": "docker:journald:container",
      "primary_id_field": "CONTAINER_ID",
      "required_fields": [
        "MESSAGE",
        "CONTAINER_ID",
        "CONTAINER_NAME",
        "IMAGE_NAME"
      ],
      "timestamp_fields": [
        "__REALTIME_TIMESTAMP"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "docker, kubernetes, or systemd depending on routed source mode",
    "product": "json_file_container_logs, cri_container_logs, engine_events, journald_service_logs, or journald_container_logs",
    "vendor_product": "source-mode specific vendor/product label",
    "stream": "stdout/stderr transport stream from Docker/CRI/journald records",
    "message": "application/service message body where preserved by source mode",
    "container_log": "raw Docker json-file log payload",
    "cri_time": "CRI line timestamp",
    "cri_flag": "CRI full/partial line flag; F marks complete log records and P marks partial fragments preserved without reassembly.",
    "event_type": "Docker Engine event Type",
    "action": "raw stream/action/transport-derived analyst action field",
    "container_id": "Docker container identifier where present",
    "container_name": "Docker journald container name where present",
    "image_name": "container image name where present",
    "host": "journald host where present",
    "service_unit": "systemd unit name from _SYSTEMD_UNIT",
    "program": "SYSLOG_IDENTIFIER or service program token",
    "severity": "journald PRIORITY numeric token where present",
    "signature": "source-mode grouping such as event Type/Action, unit, image, or stream flag",
    "signature_id": "synthetic marker family for fixture read-back",
    "marker_family": "synthetic fixture marker family extracted from SC4S_CONTAINER_RUNTIME_SYSTEMD_TEST_* markers"
