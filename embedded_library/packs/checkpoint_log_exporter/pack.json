    ],
    "docs": [
      "README.md",
      "validation/preflight-2026-06-08.md",
      "validation/e2e-lab-2026-06-27.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tcp_rfc5424",
      "label": "TCP RFC5424 syslog",
      "transport": "tcp",
      "recommended": true,
      "default_port": 514,
      "notes": "Matches upstream SC4S Check Point Log Exporter recommendation: RFC5424/IETF syslog over TCP without frame.",
      "syslog_protocol": "rfc5424_over_tcp",
      "framing": "line_delimited",
      "envelope": "ietf_rfc5424",
      "payload_format": "custom_application"
    },
    {
      "id": "tls_rfc5425",
      "label": "TLS syslog RFC5425",
      "transport": "tls",
      "recommended": false,
      "default_port": 20041,
      "notes": "Optional dedicated SecHub Resources listener when TLS is preferred; send helper wraps each RFC5424 event with octet-counted RFC5425 framing.",
      "syslog_protocol": "rfc5425",
      "framing": "octet_counted",
      "envelope": "ietf_rfc5424",
      "payload_format": "custom_application"
    },
    {
      "id": "udp_syslog",
      "label": "UDP syslog",
      "transport": "udp",
      "recommended": false,
      "default_port": 514,
      "notes": "Avoid for production; included only for legacy/lab compatibility if source configuration requires it.",
      "syslog_protocol": "udp_syslog",
      "framing": "datagram",
      "envelope": "ietf_rfc5424",
      "payload_format": "custom_application"
    }
  ],
  "recommended_transport": "tcp_rfc5424",
  "source_log_version": {
    "name": "Check Point Log Exporter RFC5424/Splunk recommended format",
    "min": null,
    "max": null,
    "notes": "Grounded in upstream SC4S Check Point Log Exporter documentation and parser shape; exact gateway/version field coverage requires real replay evidence."
  },
  "validation": {
    "date_validated": "not lab validated; curated 2026-06-05",
    "validated_by": "Hermes autonomous curation (documentation-grounded only)",
    "source_log_version": "Upstream SC4S Check Point Log Exporter docs/parser inventory plus synthetic-equivalent fixtures only",
    "sc4s_version": "not lab validated",
    "splunk_version": "not lab validated",
    "evidence": "Pack artifacts and fixtures are curated from public upstream SC4S docs/parser evidence. Live Check Point replay and Splunk read-back evidence is not yet captured; keep quality_status=curated and trust_level=unverified."
  },
  "test_event_sets": [
    {
      "id": "checkpoint_log_exporter_rfc5424_sdata",
      "label": "Check Point Log Exporter RFC5424 structured-data fixtures",
      "path": "test-events/checkpoint_log_exporter_test_events.txt",
      "format": "ietf",
      "wire_format": "rfc5424_structured_data",
      "envelope": "ietf_rfc5424",
      "serialization": "structured_data_kv",
      "event_count": 5,
      "events_per_file": "multiple",
      "event_boundary": "line",
      "record_separator": "\\n",
      "one_event_per_line": true,
      "multiline": false,
      "unique_events": true,
      "marker_tokens": [
        "SC4S_CHECKPOINT_LOG_EXPORTER_TEST_ACCEPT_001",
        "SC4S_CHECKPOINT_LOG_EXPORTER_TEST_DROP_002",
        "SC4S_CHECKPOINT_LOG_EXPORTER_TEST_IPS_DROP_003",
        "SC4S_CHECKPOINT_LOG_EXPORTER_TEST_AUDIT_LOGIN_004",
        "SC4S_CHECKPOINT_LOG_EXPORTER_TEST_EMAIL_DETECT_005"
      ],
      "timestamp_policy": {
        "source_time_mode": "syslog_header_timezone",
        "primary_field": "rfc5424_header",
        "primary_timezone": "offset included in fixture timestamps; source-defined in production",
        "fallback_fields": [
          "time"
        ],
        "fallback_time_mode": "receiver_time",
        "fallback_timezone": "receiver_default",
        "requires_source_timezone_when_fields_missing": [
          "rfc5424_header"
        ],
        "notes": "The upstream parser also parses sc4s@2620 time as epoch-like data, but this curated pack treats the qualified RFC5424 header as primary until real replay confirms production semantics."
      },
      "field_delimiting": {
        "style": "rfc5424_structured_data_key_values",
        "field_separator": "space between key=value pairs",
        "quote_character": "double quote for string values",
        "escape_policy": "Synthetic fixtures exercise quoted strings, GUIDs, backslash users, mixed-case action tokens, source/destination tuples, audit administrators, and documentation IP addresses; more real edge cases are required before validation.",
        "notes": "Treat each physical line as one event."
      },
      "expected_families": [
        "log_exporter_syslog",
        "firewall_traffic",
        "ips_protection",
        "audit_activity",
        "email_security"
      ]
    }
  ],
