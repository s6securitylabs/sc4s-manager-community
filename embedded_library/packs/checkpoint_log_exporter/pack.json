{
  "schema_version": "0.1",
  "id": "checkpoint_log_exporter",
  "version": "0.1.9",
  "url": "https://raw.githubusercontent.com/splunk/splunk-connect-for-syslog/main/docs/sources/vendor/Checkpoint/logexporter_5424.md",
  "description": "Curated SecHub Resources SC4S pack for Check Point Log Exporter RFC5424 structured-data syslog. Extends upstream SC4S Check Point syslog inventory with conservative metadata, fixtures, Splunk knowledge, and explicit validation gaps.",
  "display_name": "Check Point Log Exporter",
  "vendor": "checkpoint",
  "product": "log-exporter",
  "default_index": "netfw",
  "default_source": "checkpoint_log_exporter",
  "listener": {
    "source_id": "CHECKPOINT_LOG_EXPORTER",
    "transport": "tls",
    "port": 20041,
    "env": {
      "SC4S_LISTEN_CHECKPOINT_LOG_EXPORTER_TLS_PORT": "20041",
      "SOURCE_ALL_SET_APPEND": "CHECKPOINT_LOG_EXPORTER"
    }
  },
  "sourcetypes": {
    "log_exporter_syslog": "cp_log:syslog",
    "firewall_traffic": "cp_log:syslog",
    "ips_protection": "cp_log:syslog",
    "audit_activity": "cp_log:syslog",
    "email_security": "cp_log:syslog"
  },
  "event_families": [
    {
      "id": "log_exporter_syslog",
      "label": "Check Point Log Exporter RFC5424 structured-data events",
      "match_engine": "pcre",
      "match": "\\[sc4s@2620 .*action=",
      "expected_sourcetype": "cp_log:syslog",
      "primary_id_field": "rule_uid",
      "required_fields": [
        "action",
        "src_or_dst"
      ],
      "timestamp_fields": [
        "rfc5424_header",
        "time"
      ]
    },
    {
      "id": "firewall_traffic",
      "label": "Check Point firewall traffic accept/drop records",
      "match_engine": "pcre",
      "match": "product=\\\"(?:log-exporter|Firewall)\\\".*blade=\\\"Firewall\\\"|blade=\\\"Firewall\\\"",
      "expected_sourcetype": "cp_log:syslog",
      "primary_id_field": "rule_uid",
      "required_fields": [
        "action",
        "src",
        "dst",
        "service",
        "proto"
      ],
      "timestamp_fields": [
        "rfc5424_header",
        "time"
      ]
    },
    {
      "id": "ips_protection",
      "label": "Check Point IPS/protection records",
      "match_engine": "pcre",
      "match": "product=\\\"IPS\\\"|protection_name=|attack=",
      "expected_sourcetype": "cp_log:syslog",
      "primary_id_field": "protection_id",
      "required_fields": [
        "action",
        "protection_name",
        "src",
        "dst"
      ],
      "timestamp_fields": [
        "rfc5424_header",
        "time"
      ]
    },
    {
      "id": "audit_activity",
      "label": "Check Point SmartConsole/audit activity records",
      "match_engine": "pcre",
      "match": "product=\\\"SmartConsole\\\"|blade=\\\"Audit\\\"|administrator=",
      "expected_sourcetype": "cp_log:syslog",
      "primary_id_field": "administrator",
      "required_fields": [
        "action",
        "administrator",
        "client_ip"
      ],
      "timestamp_fields": [
        "rfc5424_header",
        "time"
      ]
    },
    {
      "id": "email_security",
      "label": "Check Point email-security detection records",
      "match_engine": "pcre",
      "match": "product=\\\"Anti Phishing\\\"|blade=\\\"Email\\\"|ifname=\\\"MTA\\\"",
      "expected_sourcetype": "cp_log:syslog",
      "primary_id_field": "protection_name",
      "required_fields": [
        "action",
        "protection_name",
        "src",
        "dst"
      ],
      "timestamp_fields": [
        "rfc5424_header",
        "time"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "Check Point",
    "product": "Log Exporter",
    "vendor_product": "checkpoint:log-exporter",
    "src": "src",
    "dest": "dst",
    "dest_port": "service",
    "proto": "raw Check Point protocol field",
    "transport": "proto",
    "action": "action",
    "signature": "rule_name or protection_name",
    "signature_id": "rule_uid or loguid",
    "user": "user",
    "vendor_raw_action": "raw Check Point action token before lower-case analyst normalization",
    "src_ip": "src or client_ip",
    "dest_ip": "dst",
    "src_port": "s_port",
    "administrator": "administrator",
    "client_ip": "client_ip",
    "protection_id": "protection_id",
    "protection_name": "protection_name",
    "attack": "attack"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-checkpoint_log_exporter.conf",
      "sc4s/env.example"
    ],
    "splunk": [
      "splunk/default/props.conf",
      "splunk/default/transforms.conf",
      "splunk/default/eventtypes.conf",
