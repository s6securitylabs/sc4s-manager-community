{
  "schema_version": "0.1",
  "id": "qnap_nas",
  "version": "0.1.3",
  "url": "https://github.com/elastic/integrations/tree/main/packages/qnap_nas",
  "description": "Conservative SecHub Resources SC4S pack for QNAP NAS QuLog/syslog messages, promoted from a community candidate using public Elastic integration sample events and parser schema evidence.",
  "display_name": "QNAP NAS",
  "vendor": "qnap",
  "product": "nas",
  "default_index": "infraops",
  "default_source": "qnap_nas",
  "listener": {
    "source_id": "QNAP_NAS",
    "transport": "tcp",
    "port": 20094,
    "env": {
      "SC4S_LISTEN_QNAP_NAS_TCP_PORT": "20094",
      "SOURCE_ALL_SET_APPEND": "QNAP_NAS"
    }
  },
  "sourcetypes": {
    "qnap_event_log": "qnap:nas:event",
    "qnap_conn_log": "qnap:nas:conn"
  },
  "event_families": [
    {
      "id": "qnap_event_log",
      "label": "QNAP event log records",
      "match_engine": "pcre",
      "match": "qulogd\\[\\d+\\]: event log: Users:",
      "expected_sourcetype": "qnap:nas:event",
      "primary_id_field": "qnap_category",
      "required_fields": [
        "user",
        "src",
        "qnap_application",
        "qnap_category",
        "message"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    },
    {
      "id": "qnap_conn_log",
      "label": "QNAP connection/access log records",
      "match_engine": "pcre",
      "match": "qulogd\\[\\d+\\]: conn log: Users:",
      "expected_sourcetype": "qnap:nas:conn",
      "primary_id_field": "action",
      "required_fields": [
        "user",
        "src",
        "qnap_connection_type",
        "qnap_resource",
        "action"
      ],
      "timestamp_fields": [
        "syslog_header"
      ]
    }
  ],
  "normalized_fields": {
    "vendor": "QNAP",
    "product": "NAS",
    "vendor_product": "qnap:nas",
    "src": "Source IP",
    "user": "Users",
    "qnap_computer_name": "Computer name from the QNAP QuLog record",
    "qnap_application": "Application field from QNAP event-log records",
    "qnap_category": "Category field from QNAP event-log records",
    "qnap_connection_type": "Connection type field from QNAP connection/access records",
    "qnap_resource": "Accessed resources field from QNAP connection/access records",
    "action": "Action or category",
    "signature": "action/category",
    "signature_id": "signature",
    "message": "Content field from QNAP event-log records",
    "marker": "synthetic fixture marker only"
  },
  "artifacts": {
    "sc4s": [
      "sc4s/app_parsers/syslog/app-qnap_nas.conf",
      "sc4s/env.example"
    ],
    "splunk": [
      "splunk/default/props.conf",
      "splunk/default/transforms.conf",
      "splunk/default/eventtypes.conf",
      "splunk/default/tags.conf",
      "splunk/default/data/ui/views/qnap_nas_overview.xml"
    ],
    "test_events": [
      "test-events/qnap_nas_test_events.txt"
    ],
    "scripts": [
      "scripts/send_tcp_20094.sh",
      "scripts/e2e_docker_compose.sh"
    ],
    "docs": [
      "README.md",
      "validation/preflight-2026-06-08.md"
    ]
  },
  "supported_transports": [
    {
      "id": "tcp_syslog",
      "label": "TCP syslog",
      "transport": "tcp",
      "recommended": true,
      "default_port": 20094,
      "notes": "Dedicated TCP listener recommended for reliable QNAP audit/event collection.",
      "syslog_protocol": "tcp_syslog",
      "framing": "line_delimited",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "custom_application"
    },
    {
      "id": "udp_syslog",
      "label": "UDP syslog",
      "transport": "udp",
      "recommended": false,
      "default_port": 514,
      "notes": "Supported by public collection guidance but not recommended for critical audit trails.",
      "syslog_protocol": "udp_syslog",
      "framing": "datagram",
      "envelope": "bsd_rfc3164_or_headerless",
      "payload_format": "custom_application"
    },
    {
      "id": "tls_rfc5425",
      "label": "TLS syslog RFC5425",
      "transport": "tls",
      "recommended": false,
      "default_port": 20045,
      "notes": "Use when an intermediary can wrap QNAP payloads in RFC5424/RFC5425 TLS.",
      "syslog_protocol": "rfc5425",
      "framing": "octet_counted",
      "envelope": "ietf_rfc5424",
      "payload_format": "custom_application"
    }
  ],
  "recommended_transport": "tcp_syslog",
  "source_log_version": {
    "name": "QNAP NAS QuLog/syslog",
    "min": null,
    "max": null,
    "notes": "Grounded in public Elastic qnap_nas integration sample events and parser schema; exact QTS/QuTS hero release coverage needs device replay."
  },
  "validation": {
    "date_validated": "not lab validated; curated 2026-06-05",
    "validated_by": "Hermes autonomous curation (public evidence only)",
    "source_log_version": "Elastic qnap_nas public sample logs and ingest pipeline schema; synthetic-equivalent fixtures only",
    "sc4s_version": "not lab validated",
    "splunk_version": "not lab validated",
    "evidence": "Public examples confirm BSD-style qulogd event log and conn log message shapes. Live QNAP replay and Splunk read-back evidence is not yet captured; keep quality_status=curated and trust_level=unverified."
  },
  "test_event_sets": [
    {
      "id": "qnap_nas_bsd_syslog",
      "label": "QNAP NAS BSD syslog fixtures",
      "path": "test-events/qnap_nas_test_events.txt",
      "format": "bsd",
      "wire_format": "bsd_syslog_qulogd_message",
      "envelope": "bsd_rfc3164_or_headerless",
      "serialization": "custom_application",
      "event_count": 4,
      "events_per_file": "multiple",
      "event_boundary": "line",
      "record_separator": "\n",
      "one_event_per_line": true,
      "multiline": false,
      "unique_events": true,
      "marker_tokens": [
        "SC4S_QNAP_NAS_CONN_001",
        "SC4S_QNAP_NAS_CONN_002",
        "SC4S_QNAP_NAS_EVENT_003",
        "SC4S_QNAP_NAS_EVENT_004"
      ],
      "timestamp_policy": {
        "source_time_mode": "receiver_time",
        "primary_field": "syslog_header",
        "primary_timezone": "BSD/RFC3164 fixture timestamps contain no year or timezone",
        "fallback_fields": [],
        "fallback_time_mode": "receiver_time",
        "fallback_timezone": "receiver_default",
        "requires_source_timezone_when_fields_missing": [
          "syslog_header_timezone"
        ],
        "notes": "Configure QNAP source timezone in production for deterministic read-back."
      },
      "field_delimiting": {
        "style": "qnap_label_value_pairs",
        "field_separator": "comma-separated label/value pairs after log family prefix",
        "quote_character": "double quotes may appear in content values",
        "escape_policy": "Synthetic fixtures preserve backslashes, spaces, quoted folder names, and documentation IP addresses.",
        "notes": "Only top-level QNAP fields are extracted; nested content remains message text."
      },
      "expected_families": [
        "qnap_conn_log",
        "qnap_event_log"
      ]
    }
  ],
