{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sechub-resources.local/schemas/pack.schema.json",
  "title": "SecHub Resources SC4S source-component and Library pack manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "version",
    "url",
    "description",
    "display_name",
    "vendor",
    "product",
    "default_index",
    "default_source",
    "listener",
    "sourcetypes",
    "event_families",
    "artifacts",
    "supported_transports",
    "recommended_transport",
    "source_log_version",
    "source_delivery",
    "validation",
    "test_event_sets",
    "export_artifacts",
    "provenance",
    "relationship_to_upstream",
    "trust_level",
    "quality_status",
    "field_contract",
    "ci"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "default_index": {
      "type": "string",
      "minLength": 1
    },
    "default_source": {
      "type": "string",
      "minLength": 1
    },
    "listener": {
      "type": "object",
      "required": [
        "source_id",
        "transport",
        "port",
        "env"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "transport": {
          "enum": [
            "udp",
            "tcp",
            "tls"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "env": {
          "type": "object"
        }
      }
    },
    "sourcetypes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "event_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "match_engine",
          "match",
          "expected_sourcetype",
          "primary_id_field",
          "required_fields",
          "timestamp_fields"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "match_engine": {
            "enum": [
              "pcre"
            ]
          },
          "match": {
            "type": "string"
          },
          "expected_sourcetype": {
            "type": "string"
          },
          "primary_id_field": {
            "type": "string"
          },
          "required_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "supported_transports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "transport",
          "syslog_protocol",
          "framing",
          "envelope",
          "payload_format",
          "recommended",
          "default_port"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "transport": {
            "enum": [
              "udp",
              "tcp",
              "tls"
            ]
          },
          "syslog_protocol": {
            "enum": [
              "rfc5425",
              "rfc5424_over_tcp",
              "udp_syslog",
              "tcp_syslog"
            ]
          },
          "framing": {
            "enum": [
              "octet_counted",
              "line_delimited",
              "datagram"
            ]
          },
          "envelope": {
            "enum": [
              "ietf_rfc5424",
              "bsd_rfc3164_or_headerless",
              "none"
            ]
          },
          "payload_format": {
            "enum": [
              "custom_application",
              "json",
              "cef",
              "csv",
              "raw"
            ]
          },
          "recommended": {
            "type": "boolean"
          },
          "default_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "recommended_transport": {
      "type": "string"
    },
    "source_log_version": {
      "type": "object",
      "required": [
        "name",
        "min",
        "max",
        "notes"
      ]
    },
    "source_delivery": {
      "type": "object",
      "description": "Collection-mode metadata. This classifies whether records are SC4S/syslog-native, API/cloud/Event Hub relay, JSON/XML/file relay, or catalogue-only; it is not validation evidence.",
      "required": [
        "mode",
        "sc4s_native",
        "collector_required",
        "payload_format",
        "notes",
        "validation_status"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "sc4s_native": {
          "type": "boolean"
        },
        "collector_required": {
          "type": "boolean"
        },
        "payload_format": {
          "type": "string",
          "minLength": 1
        },
        "supported_transport_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "date_validated",
        "validated_by",
        "source_log_version",
        "sc4s_version",
        "splunk_version",
        "evidence"
      ]
    },
    "validation_harness": {
      "type": "object",
      "description": "Optional pack-aware SC4S replay/readback requirements. This is an operator/agent harness requirements, not validation evidence by itself.",
      "required": [
        "status",
        "required_for_quality_promotion",
        "harness",
        "replay",
        "readback"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "blocked",
            "sent_no_readback",
            "partial",
            "failed",
            "passed"
          ]
        },
        "required_for_quality_promotion": {
          "type": "boolean"
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "pack_aware": {
          "type": "boolean"
        },
        "testbed": {
          "type": "object"
        },
        "preflight": {
          "type": "object"
        },
        "replay": {
          "type": "object",
          "required": [
            "fixture_sets",
            "event_count",
            "marker_prefix",
            "transport",
            "framing"
          ],
          "properties": {
            "fixture_sets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "event_count": {
              "type": "integer",
              "minimum": 1
            },
            "marker_prefix": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "type": "string"
            },
            "framing": {
              "type": "string"
            },
            "script": {
              "type": "string"
            }
          }
        },
        "readback": {
          "type": "object",
          "required": [
            "spl",
            "expected_count",
            "must_verify"
          ],
          "properties": {
            "spl": {
              "type": "string",
              "minLength": 1
            },
            "expected_count": {
              "type": "integer",
              "minimum": 1
            },
            "must_verify": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "last_attempt": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "not_run",
                "blocked",
                "sent_no_readback",
                "partial",
                "failed",
                "passed"
              ]
            },
            "blocked_layer": {
              "enum": [
                "no_testbed",
                "listener",
                "source_mapping",
                "send",
                "parser",
                "hec",
                "index_preflight",
                "splunk_search_auth",
                "indexed_readback",
                "metadata_mismatch"
              ]
            },
            "date": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "evidence_path": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "evidence": {
          "type": "array"
        }
      }
    },
    "test_event_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "format",
          "wire_format",
          "event_count",
          "events_per_file",
          "event_boundary",
          "record_separator",
          "one_event_per_line",
          "multiline",
          "unique_events",
          "marker_tokens",
          "timestamp_policy",
          "field_delimiting",
          "expected_families"
        ],
        "properties": {
          "format": {
            "enum": [
              "bsd",
              "ietf",
              "cef",
              "csv",
              "hybrid",
              "raw",
              "custom_application"
            ]
          },
          "events_per_file": {
            "enum": [
              "single",
              "multiple"
            ]
          },
          "event_boundary": {
            "enum": [
              "line",
              "rfc5424_octet_counting",
              "delimiter",
              "multiline_pattern",
              "payload_defined"
            ]
          },
          "event_count": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp_policy": {
            "type": "object",
            "required": [
              "source_time_mode",
              "primary_field",
              "primary_timezone",
              "fallback_time_mode",
              "fallback_timezone",
              "requires_source_timezone_when_fields_missing"
            ],
            "properties": {
              "source_time_mode": {
                "enum": [
                  "field_utc_epoch",
                  "field_with_timezone",
                  "field_without_timezone_source_local",
                  "syslog_header_timezone",
                  "receiver_time",
                  "unknown_requires_validation"
                ]
              },
              "fallback_time_mode": {
                "enum": [
                  "field_utc_epoch",
                  "field_with_timezone",
                  "field_without_timezone_source_local",
                  "source_local_time_requires_timezone",
                  "syslog_header_timezone",
                  "receiver_time",
                  "unknown_requires_validation"
                ]
              }
            }
          }
        }
      }
    },
    "export_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "source_path",
          "target_path",
          "kind",
          "rendered",
          "contains_secrets",
          "required"
        ],
        "properties": {
          "group": {
            "enum": [
              "sc4s",
              "splunk",
              "test_events",
              "scripts",
              "docs"
            ]
          },
          "rendered": {
            "type": "boolean"
          },
          "contains_secrets": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "dashboard_screenshots": {
      "type": "array",
      "description": "Optional sanitized dashboard screenshot examples for documentation/detail pages. These are illustrative screenshots only, not validation or customer deployment evidence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source_path",
          "format",
          "sanitized",
          "example_only",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_][a-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dashboard_id": {
            "type": "string"
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(png|jpg|jpeg|webp)$"
          },
          "format": {
            "enum": [
              "png",
              "jpg",
              "jpeg",
              "webp"
            ]
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "sanitized": {
            "const": true,
            "description": "Screenshots must be public/sanitized and must not include tenant IDs, private hostnames, secrets, customer identifiers, or private log samples."
          },
          "example_only": {
            "const": true,
            "description": "True when the screenshot is an illustrative documentation example and not validation evidence."
          },
          "scope": {
            "const": "splunk_test_documentation_example_only",
            "description": "Explicit screenshot scope proving the asset is a sanitized Splunk TEST documentation example, not replay/read-back validation evidence."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "pack_class",
        "source",
        "curation"
      ],
      "properties": {
        "origin": {
          "enum": [
            "sc4s-inbuilt",
            "sc4s-inbuilt-lite",
            "sechub-resources-pack",
            "community-extra"
          ]
        },
        "pack_class": {
          "enum": [
            "sc4s-inbuilt",
            "sc4s-inbuilt-lite",
            "sechub-resources-pack",
            "community-extra"
          ]
        },
        "community_promotion": {
          "type": "boolean",
          "description": "Explicit lineage marker for curated packs promoted from community/source-corpus material; when true, validate_pack enforces release evidence before curated/validated statements."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reference",
            "redistribution"
          ],
          "properties": {
            "type": {
              "enum": [
                "vendor_docs",
                "lab",
                "customer",
                "synthetic",
                "upstream_issue",
                "support_case",
                "upstream_sc4s",
                "mixed"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "redistribution": {
              "enum": [
                "commit_safe",
                "private_only",
                "synthetic_only",
                "unknown"
              ]
            },
            "sanitisation_status": {
              "enum": [
                "not_required",
                "sanitised",
                "synthetic_equivalent",
                "pending_review",
                "unknown"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "curation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed_by",
            "reviewed_at",
            "notes"
          ],
          "properties": {
            "reviewed_by": {
              "type": "string",
              "minLength": 1
            },
            "reviewed_at": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "sc4s_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "relationship_to_upstream": {
      "enum": [
        "upstream_only",
        "new_pack",
        "extends_upstream",
        "overrides_upstream",
        "adds_postfilters",
        "adds_reduction_rules",
        "adds_splunk_knowledge",
        "docs_only",
        "deprecated"
      ]
    },
    "trust_level": {
      "enum": [
        "unverified",
        "community_submitted",
        "trusted_contributor_verified",
        "s6_verified",
        "field_verified"
      ]
    },
    "quality_status": {
      "enum": [
        "catalogued",
        "draft",
        "curated",
        "validated",
        "field_validated",
        "deprecated"
      ]
    },
    "reduction_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "artifact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_][a-z0-9_.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "drop_behavior": {
            "enum": [
              "drops_events",
              "routes_to_null_queue",
              "metadata_only",
              "unknown_requires_review"
            ]
          },
          "safety_notes": {
            "type": "string"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "path"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).*\\.(conf|csv)$"
              },
              "kind": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "logging_presets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "enabled_by_default",
          "artifact_references",
          "reduction_rules"
        ],
        "properties": {
          "id": {
            "enum": [
              "basic",
              "standard",
              "enhanced"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "enabled_by_default": {
            "type": "boolean"
          },
          "artifact_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "path"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).*\\.(conf|csv)$"
                },
                "kind": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "reduction_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "field_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cim",
        "ocsf",
        "ecs"
      ],
      "properties": {
        "cim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mapping_status",
            "primary",
            "fields"
          ],
          "properties": {
            "mapping_status": {
              "enum": [
                "complete",
                "partial",
                "not_applicable",
                "unknown"
              ]
            },
            "primary": {
              "const": true
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_fields",
                  "status",
                  "notes"
                ],
                "properties": {
                  "source_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "enum": [
                      "complete",
                      "partial",
                      "not_applicable",
                      "unknown"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "ocsf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mapping_status",
            "secondary",
            "fields"
          ],
          "properties": {
            "mapping_status": {
              "enum": [
                "complete",
                "partial",
                "not_applicable",
                "unknown"
              ]
            },
            "secondary": {
              "const": true
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_fields",
                  "status",
                  "notes"
                ],
                "properties": {
                  "source_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "enum": [
                      "complete",
                      "partial",
                      "not_applicable",
                      "unknown"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "ecs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mapping_status",
            "optional",
            "fields"
          ],
          "properties": {
            "mapping_status": {
              "enum": [
                "complete",
                "partial",
                "not_applicable",
                "unknown"
              ]
            },
            "optional": {
              "const": true
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_fields",
                  "status",
                  "notes"
                ],
                "properties": {
                  "source_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "enum": [
                      "complete",
                      "partial",
                      "not_applicable",
                      "unknown"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "required": [
        "last_updated",
        "last_tested",
        "tested_commit",
        "tested_artifact_hashes"
      ],
      "properties": {
        "last_updated": {
          "type": "string",
          "minLength": 1
        },
        "last_tested": {
          "type": "string",
          "minLength": 1
        },
        "tested_commit": {
          "type": "string",
          "minLength": 1
        },
        "tested_artifact_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "source_pack_kind": {
      "enum": [
        "sc4s_source_pack",
        "generic_log_source_definition"
      ],
      "description": "Optional expansion marker. Current public release remains SC4S-first; generic_log_source_definition is for pipeline-agnostic future packs with adapters."
    },
    "source_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Optional high-level source categories for future generic log-source discovery, e.g. firewall, identity, endpoint, storage, network."
    },
    "supported_targets": {
      "type": "array",
      "items": {
        "enum": [
          "sc4s",
          "splunk",
          "syslog_ng",
          "vector",
          "cribl",
          "logstash",
          "elastic",
          "fluent_bit",
          "data_prepper",
          "opensearch_dashboards",
          "otel",
          "generic"
        ]
      },
      "uniqueItems": true,
      "description": "Optional target runtimes/adapters this source definition can support. v1 packs usually expose sc4s, syslog_ng, and/or splunk."
    },
    "pack_variants": {
      "type": "array",
      "minItems": 1,
      "description": "Optional first-class log-format/source-mode variants. Use when one logical product emits materially different payload shapes or source modes that should not be treated as mere pack versions.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "label",
          "description",
          "default",
          "evidence_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_][a-z0-9_.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "type": "boolean"
          },
          "evidence_status": {
            "enum": [
              "catalogued",
              "curated",
              "validated",
              "field_validated",
              "unknown"
            ]
          },
          "source_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "payload_formats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "envelopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "event_families": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "test_event_sets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "supported_targets": {
            "type": "array",
            "items": {
              "enum": [
                "sc4s",
                "splunk",
                "syslog_ng",
                "vector",
                "cribl",
                "logstash",
                "elastic",
                "fluent_bit",
                "data_prepper",
                "opensearch_dashboards",
                "otel",
                "generic"
              ]
            },
            "uniqueItems": true
          },
          "artifact_references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "field_requirements_overrides": {
            "type": "object"
          },
          "known_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "description": "Optional adapter-specific metadata. Keep reusable source identity, variants, event families, required-field coverages, fixtures, and evidence in core fields; use adapters for target-specific SC4S/Splunk/etc. implementation details.",
      "additionalProperties": {
        "type": "object"
      },
      "properties": {
        "sc4s": {
          "type": "object"
        },
        "splunk": {
          "type": "object"
        },
        "syslog_ng": {
          "type": "object"
        },
        "vector": {
          "type": "object"
        },
        "cribl": {
          "type": "object"
        },
        "logstash": {
          "type": "object"
        },
        "elastic": {
          "type": "object"
        },
        "fluent_bit": {
          "type": "object"
        },
        "otel": {
          "type": "object"
        },
        "generic": {
          "type": "object"
        },
        "data_prepper": {
          "type": "object"
        },
        "opensearch_dashboards": {
          "type": "object"
        }
      }
    },
    "splunk_app": {
      "type": "object",
      "description": "Optional reference-only Splunk knowledge metadata carried by an SC4S Library compatibility pack. Files targeting splunk_app/ are staged for inspection and are not installed by SC4S Manager. Product TA packaging and installation belong to the canonical products/ release workflow.",
      "additionalProperties": false,
      "required": [
        "app_id",
        "label"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
